var black_15 = new TextFormat (Fonts.DETAIL_FONT, 15, 0x090909);
var red_20 = new TextFormat (Fonts.DETAIL_FONT, 20, 0x900900);
var green_20 = new TextFormat (Fonts.DETAIL_FONT, 20, 0x009009);

var eventSprite = null;
var STATUS_EXPIRED 		= 0;		 //      no	(early)		no			n/a
var STATUS_CLAIMED 		= 1;		//		 n/a			yes			n/a
var STATUS_COMPLETED 	= 2;		//		 yes			no			yes
var STATUS_WAITGET		= 3;		//		 yes			n/a			no
var STATUS_NOTNOW	   	= 4;		//		 no	(late)		n/a			n/a
var mainLayer;
functionList.set ("init", function ()
{
	Resource.loadSprite ("GFX_EVENT_2_9");
	eventSprite = Resource.getSprite ("GFX_EVENT_2_9");

	mapObj	= Utilities.createMap ();
	mapData	= Utilities.createMap ();
	this.callFunction ("init_constant");
	
	mainLayer = new Layer ();
	mainLayer.x = -320;
	mainLayer.y = -100;
	this.add (mainLayer);
	
	var background = eventSprite.GetFrame (DF_EVENT.FRAME_BACKGROUND, 0, 0);
	mainLayer.add (background);
	
	var close = new Button (eventSprite._sprite_id, DF_EVENT.ANIM_CLOSE, DF_EVENT.ANIM_CLOSE, DF_EVENT.ANIM_CLOSE);
	close.x = 640 - 21;
	close.y = 21;
	close.addEventListener (MouseEvent.CLICK, function (e) { this.releaseFromParent (); });
	mainLayer.add (close);
	
	var completedBtn = new Button (eventSprite._sprite_id, DF_EVENT.ANIM_COMPLETED_NORMAL, DF_EVENT.ANIM_COMPLETED_TOUCH, DF_EVENT.ANIM_COMPLETED_DISABLE);
	completedBtn.m_id = 9;
	completedBtn.x = 320;
	completedBtn.y = 960 - 33;
	completedBtn.set_disable (true);
	completedBtn.addEventListener (MouseEvent.CLICK, function (e)
	{
		var itemStatusArr = RewardItemInfo.GetDinamicListRewards();
		var idRewardReceivedArr = RewardItemInfo.finish_recieve_rewards;
		var quest = constant.event2.main;
		this.callFunction ("updateStatus", [quest, itemStatusArr, idRewardReceivedArr]);
		
		if (quest.status == STATUS_CLAIMED)
		{
			PixmaGame.notification.showPopup (TextWrapper.getString("TEXT_CONFIRM"), "<p align=\"center\">Bạn đã nhận phần quà này rồi</p>", 1);
		}
		else if (quest.status == STATUS_COMPLETED)
		{
			PixmaGame._instance.fbClient.send (RequestGennarator.receiveDailyReward(quest.id));
			PixmaGame._instance.fbClient.addEventListener(FBEvent.RECEIVE_REWARD, function (params)
			{
				PixmaGame._instance.fbClient.removeEventListener (FBEvent.RECEIVE_REWARD);
				this.callFunction ("update", []);
				PixmaGame.notification.showPopup (TextWrapper.getString("TEXT_CONFIRM"), "<p align=\"center\">Xin Chúc mừng\nBạn đã nhận quà thành công</p>", 1);
			});
		}
		else
		{
			var currentQuest = quest.currentValue;
			currentQuest = 9 - currentQuest;
			var currentRune = currentQuest*25000;
			var popup = PixmaGame.notification.showPopup (TextWrapper.getString("TEXT_CONFIRM"), "<p align=\"center\">Bạn còn thiếu "+currentQuest+" nhiệm vụ\nCó muốn sữ dụng "+currentRune+" [Rune] để hoàn thành</p>", 3);
			popup.okBtn.addEventListener (MouseEvent.CLICK,
			function (e)
			{
				this.callFunction ("request_forceFinish", [quest.id]);
				PixmaGame._instance.fbClient.addEventListener("EVENT_SCRIPT_REQUEST_forceFinish", function (params)
				{
					
					var obj = params.get("data");
					var run =  obj.get("run");
					trace ("EVENT_SCRIPT_REQUEST_forceFinish: " + run);
					trace ("UserInfo.rune: " + UserInfo.rune);
					UserInfo.set_rune(UserInfo.rune- run);
					trace ("UserInfo.rune: " + UserInfo.rune);
					this.callFunction ("update", []);
					PixmaGame._instance.fbClient.send (RequestGennarator.receiveDailyReward(quest.id));
					PixmaGame._instance.fbClient.addEventListener(FBEvent.RECEIVE_REWARD, function (params)
					{
						PixmaGame._instance.fbClient.removeEventListener (FBEvent.RECEIVE_REWARD);
						this.callFunction ("update", []);
						PixmaGame.notification.showPopup (TextWrapper.getString("TEXT_CONFIRM"), "<p align=\"center\">Xin Chúc mừng\nBạn đã nhận quà thành công</p>", 1);
					});
				});
			});
		
			
		}
		
	});
	
	mapObj.set ("completedBtn", completedBtn);
	mainLayer.add (completedBtn);
	
	var index = 0;
	var requires = [];
	while (index < 9)
	{
		var quest = constant.event2.quest [index];
		var piece = new Layer ();
		piece.x = 118 + (index % 3) * 206;
		piece.y = 330 + Math.floor (index / 3) * 194;
		mapObj.set ("piece" + index, piece);
		
		piece.add (eventSprite.GetFrame (DF_EVENT.FRAME_PIECE_0 + index));
		
		var title = Label.create ("<p align=\"center\">Nhiệm vụ " + (index + 1) +"\n" + quest.desc + "</p>", black_15, 0, -95, Anchor.center_top);
		piece.add (title);
		
		var progress = Label.create ("(0/" + quest.require + ")", red_20, 0, -60, Anchor.center_top);
		requires [index] = quest.require;
		mapObj.set ("progress" + index, progress);
		piece.add (progress);
		
		var item = new ShopItem (quest.reward.type, quest.reward.id);
		var itemIcon = this.callFunction ("gameItem_to_obj", [item, "x" + quest.reward.num, black_15]);
		itemIcon.y = 10;
		piece.add (itemIcon);
		
		var getBtn = new Button (eventSprite._sprite_id, DF_EVENT.ANIM_PIECE_NORMAL, DF_EVENT.ANIM_PIECE_TOUCH, DF_EVENT.ANIM_PIECE_DISABLE);
		getBtn.m_id = index;
		getBtn.y = 70;
		getBtn.set_disable (true);
		getBtn.addEventListener (MouseEvent.CLICK, function (e)
		{
			PixmaGame._instance.fbClient.send (RequestGennarator.receiveDailyReward(quest.id));
			PixmaGame._instance.fbClient.addEventListener(FBEvent.RECEIVE_REWARD, function (params)
			{
				PixmaGame._instance.fbClient.removeEventListener (FBEvent.RECEIVE_REWARD);
				this.callFunction ("update", []);
				PixmaGame.notification.showPopup (TextWrapper.getString("TEXT_CONFIRM"), "<p align=\"center\">Xin Chúc mừng\nBạn đã nhận quà thành công</p>", 1);
			});
		});
		mapObj.set ("getBtn" + index, getBtn);
		piece.add (getBtn);
		
		mainLayer.add (piece);
		index ++;
	}
	mapData.set ("requires", requires);

	this.callFunction ("update", []);
	
});
functionList.set ("response", function (params)
{
	trace ("response: " + params);
	var data = params.get("data");
	
	var cmd = data.get("cmd");
	trace ("response: " + cmd);
	if (cmd == "forceFinish")
		this.callFunction ("response_forceFinish", [data]);
});


functionList.set ("response_forceFinish", function (responseObj)
{
	var run =  responseObj.get("run");
	UserInfo.rune -= run;
	PixmaGame._instance.fbClient.send (RequestGennarator.receiveDailyReward(quest.id));
	PixmaGame._instance.fbClient.addEventListener(FBEvent.RECEIVE_REWARD, function (params)
	{
					PixmaGame._instance.fbClient.removeEventListener (FBEvent.RECEIVE_REWARD);
					this.callFunction ("update", []);
					PixmaGame.notification.showPopup (TextWrapper.getString("TEXT_CONFIRM"), "<p align=\"center\">Xin Chúc mừng\nBạn đã nhận quà thành công</p>", 1);
	});
});
functionList.set ("request_forceFinish", function (rewardId)
{
	trace ("request_evolve");
	var requestObj = new FBObjectOutput();
	requestObj.putString("cmd", "forceFinish");
	requestObj.putInt("id", rewardId);
	this.callFunction ("request_script", [requestObj]);
});

functionList.set ("request_script", function (requestObj)
{
	var request = RequestGennarator.scriptRequest("forceFinish", requestObj);
	PixmaGame._instance.fbClient.send (request);
});
functionList.set ("callPopup", function (msg)
{
	var w = 550;
	var h = 300;
	var popup = new Layer();
	// popup.x = 320;
	popup.y = 480;
	var hide = new ColorRect(0x000000, 0.0, -320, -480, 640, 960);
	hide.x = 0;
	hide.y = 0;
	popup.addChild(hide);
	var bg = new ColorRect(0x000000, 0.7, -320, -200, 640, 400);
	bg.x = 0;
	bg.y = 0;
	popup.addChild(bg);
	popup.addChild(Border.roundRect (0, 0, -w/2, -h/2, w , h, 30, 0, 0x000000, 1, 0xFFFFFF));
	
	var closeBtn = this.callFunction ("getCloseButton", []);
	closeBtn.x = 240;
	closeBtn.y = -120;
	popup.addChild(closeBtn);
	popup.addChild(Label.create(msg, Fonts.TITLE_BLACK_20, 0, -50, Anchor.center_center));
	this.add(popup);
	
	popup.addEventListener (MouseEvent.CLICK, function(e){
		this.remove(popup);
	});
	
	return popup;
});

functionList.set ("update", function ()
{
	var itemStatusArr = RewardItemInfo.GetDinamicListRewards();
	var idRewardReceivedArr = RewardItemInfo.finish_recieve_rewards;
	
	var index = -1;
	var completed = 0;
	while (index < 8)
	{
		index ++;
		var quest = constant.event2.quest [index];
		trace("quest id: " + quest);
		this.callFunction ("updateStatus", [quest, itemStatusArr, idRewardReceivedArr]);
		if(quest.status == STATUS_CLAIMED)
		{
			var piece = mapObj.get ("piece" + index);
			if (piece == null) continue;
			
			piece.visible = false;
			completed ++;
			continue;
		}
		
		var progress = mapObj.get ("progress" + index);
		if (progress == null) continue;
		progress.set_text ("(" + quest.currentValue + "/" + quest.require+ ")");
		
		var getBtn = mapObj.get ("getBtn" + index);
		if (getBtn == null) continue;
		
		if (quest.status == STATUS_COMPLETED)
		{
			getBtn.set_disable (false);
			progress.set_textFormat (green_20);
			
		}
		else
		{
			getBtn.set_disable (true);
			progress.set_textFormat (red_20);
		}
		
	}
	var quest = constant.event2.main;
	this.callFunction ("updateStatus", [quest, itemStatusArr, idRewardReceivedArr]);
	var completedBtn = mapObj.get ("completedBtn");
	if (quest.status == STATUS_CLAIMED)
	{
		completedBtn.visible = false;
	}
	// else if (quest.status == STATUS_COMPLETED)
	// {
		// completedBtn.set_disable (false);
		// completedBtn.visible = true;
	// }
	else
	{
		completedBtn.set_disable (false);
		completedBtn.visible = true;
	}
	
});

functionList.set ("updateStatus", function (info, itemStatusArr, idRewardReceivedArr)
{
	info.status = STATUS_NOTNOW;		
	for(id in idRewardReceivedArr)
	{
		if(id == info.id)
		{
			info.status = STATUS_CLAIMED;
			return;
		}
	}
	for(item in itemStatusArr)
	{
		if(item.itemId == info.id)
		{
			info.currentValue = item.currentValue;
			if(item.isFinish)
			{
				info.status = STATUS_COMPLETED;
				
				return;
			}
			else
			{
				info.status = STATUS_WAITGET;
				return;
			}
		}
	}
});

