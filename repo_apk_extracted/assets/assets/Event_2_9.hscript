//GFX_EVENT_2_9
var DF_EVENT = {};
DF_EVENT.FRAME_BACKGROUND			= 0;
DF_EVENT.FRAME_CLOSE				= 1;
DF_EVENT.FRAME_PIECE_NORMAL			= 2;
DF_EVENT.FRAME_PIECE_TOUCH			= 3;
DF_EVENT.FRAME_PIECE_DISABLE		= 4;
DF_EVENT.FRAME_COMPLETED_NORMAL		= 5;
DF_EVENT.FRAME_COMPLETED_TOUCH		= 6;
DF_EVENT.FRAME_COMPLETED_DISABLE	= 7;
DF_EVENT.FRAME_PIECE_0				= 8;
DF_EVENT.FRAME_PIECE_1				= 9;
DF_EVENT.FRAME_PIECE_2				= 10;
DF_EVENT.FRAME_PIECE_3				= 11;
DF_EVENT.FRAME_PIECE_4				= 12;
DF_EVENT.FRAME_PIECE_5				= 13;
DF_EVENT.FRAME_PIECE_6				= 14;
DF_EVENT.FRAME_PIECE_7				= 15;
DF_EVENT.FRAME_PIECE_8				= 16;
DF_EVENT.ANIM_CLOSE					= 0;
DF_EVENT.ANIM_PIECE_NORMAL			= 1;
DF_EVENT.ANIM_PIECE_TOUCH			= 2;
DF_EVENT.ANIM_PIECE_DISABLE			= 3;
DF_EVENT.ANIM_COMPLETED_NORMAL		= 4;
DF_EVENT.ANIM_COMPLETED_TOUCH		= 5;
DF_EVENT.ANIM_COMPLETED_DISABLE		= 6;

