functionList.set ("getCloseButton", function (x, y)
{
	var closeBtn = new DisplayObject (x, y);
	var graphic = closeBtn.getGraphics();
	graphic.clear ();
	graphic.lineStyle (1.5, 0xFFFFFF, 1.0);
	graphic.beginFill (0x000000, 0.5);
	graphic.drawCircle (0, 0, 24);
	graphic.endFill ();
	
	graphic.lineStyle (3, 0xFFFFFF, 1.0);
	graphic.moveTo (-10, -10);
	graphic.lineTo (10, 10);
	graphic.moveTo (10, -10);
	graphic.lineTo (-10, 10);
	
	return closeBtn;
});

functionList.set ("callPopup", function (content, parent)
{
	var w = 550;
	var h = 300;
	
	var popup = new Layer();
	popup.x = 320;
	popup.y = 480;
	
	var parentObj = null;
	if (Std.is (parent, DisplayObject))
		parentObj = parent;
	else if (Std.is (parent, String))
	{
		var unknow = mapObj.get (parent);
		if (Std.is (unknow, DisplayObject))
			parentObj = unknow;
	}
	
	var background = new ColorRect(0x000000, 0.5, -320, -480, 640, 960);
	background.name = "background";
	background.addEventListener (MouseEvent.CLICK, function (e) { parentObj.remove (popup); });
	popup.addChild (background);
	
	var closeBtn = this.callFunction ("getCloseButton", [245, -120]);
	closeBtn.addEventListener (MouseEvent.CLICK, function (e) { popup.dispatchEvent (new Event (Event.CLOSE)); });
	popup.addChild (closeBtn);

	popup.addEventListener (Event.CLOSE, function (e) { parentObj.remove (popup); });
	
	var addHeight = 0;
	if (content != null)
	{
		if (Std.is (content, String))
		{
			var label = Label.create (content, Fonts.DETAIL_BLACK_20, 0, 0, Anchor.center_center);
			popup.add (label);
		}
		else if (Std.is (content, DisplayObject))
		{
			popup.add (content);
			var bound = content.getBounds (popup);
			if (bound.bottom > h / 2) addHeight = bound.bottom - h * 0.5 + 20;
		}
	}
	
	popup.addChildAt (Border.roundRect (0, 0, -w * 0.5, -h * 0.5, w, h + addHeight, 30, 2, 0x555555, 1, 0xFFFFFF), 1);
	
	parentObj.add (popup);
	return popup;
});

functionList.set ("callGiftPopup", function (title, rewards, parent)
{
	var titleLb = Label.create (title, Fonts.DETAIL_BLACK_20, 0, -80, Anchor.center_center);
	
	var rewardObjs = [];
	for (reward in rewards)
	{
		var gameItem = new ShopItem (reward.type, reward.id);
		var iconObj = this.callFunction ("gameItem_to_obj", [gameItem, reward.num, Fonts.DETAIL_BLACK_20]);
		
		var icon = iconObj.getChildByName ("icon");
		if (icon != null) icon.set_scale (0.8);
		
		var number = iconObj.getChildByName ("number");
		if (number != null) number.y = 35;
		
		rewardObjs.push (iconObj);
	}
	var giftLayer = this.callFunction ("arrange_gift", [rewardObjs]);
	
	var layer = new Layer ();
	layer.add (titleLb);
	layer.add (giftLayer);
	
	this.callFunction ("callPopup", [layer, parent]);
});

functionList.set ("callError", function (errorMsg, parent)
{
	var title = Label.create ("Cảnh Báo", Fonts.DETAIL_BLACK_30, 0, -80, Anchor.center_center);
	var msg = Label.create ("<p align=\"center\">" + errorMsg + "</p>", Fonts.DETAIL_BLACK_20, 0, -40, Anchor.center_center, 500);
	
	var popup = new Layer ();
	popup.add (title);
	popup.add (msg);
	
	this.callFunction ("callPopup", [popup, parent]);
});

functionList.set ("callItemHint", function (e, gameItem, x, y)
{
	trace ("callItemHint");
	if (gameItem == null) return;
	
	var name = gameItem.toString ();
	var desc = [];
	
	if (gameItem.type == GameItemType.Equipment)
	{
		var equipInfo = EquipInfo.GetEquip (gameItem.index);
		if (equipInfo != null)
		{
			for (pro in equipInfo.get_list_properties (0))
			{
				equipPDesc = "";
				desc.push (pro.desc);
			}
		}
	}
	else if (gameItem.type == GameItemType.Special_Item)
	{
		var item = SpecialItemInfo.get (gameItem.index);
		name = item.name;
		
		if (item.desc != null && item.desc != "")
			desc.push (item.desc);
	}
	
	var text = name;
	for (d in desc) text += "\n" + d;
	
	var hint = new Hint (x, y, text, Anchor.center_bottom, 520);
	return hint;
});

functionList.set ("item_count", function (itemId)
{
	return StockManager.countSpecialItem (itemId);
});

functionList.set ("request_info", function (eventId)
{
	trace ("request_info: " + eventId);
	var requestObj = new FBObjectOutput();
	requestObj.putString("cmd", "info");
	requestObj.putInt("id", eventId);
	this.callFunction ("request_script", [requestObj]);
	
});

functionList.set ("response_info", function (responseObj)
{
	trace ("response_info");
	var eventId = responseObj.get("id");
	var isEnable = responseObj.get("onl");
	
	var counter = responseObj.get("counter");//[10, 0, 0, 0, 20, 0, 30, 40, 0];
	mapData.set ("counter", counter);
	
	var receives = responseObj.get("receives");//[false, true, false, false, true, false, false, false, false, false];
	mapData.set ("receives", receives);
	
	this.callFunction ("update");
});

functionList.set ("request_receice", function (eventId, rewardId)
{
	var requestObj = new FBObjectOutput();
	requestObj.putString("cmd", "receive");
	requestObj.putInt("id", eventId);
	requestObj.putInt("count", rewardId);
	this.callFunction ("request_script", [requestObj]);
});

functionList.set ("response_receice", function (responseObj)
{
	trace ("response_receice: " + responseObj);
	if(responseObj.has("emess")){
		var errorMsg = responseObj.get("emess");
		this.callFunction ("callError", [errorMsg, "mainLayer"]);
		return;
	}
	var eventId = responseObj.get("id");
	var rewardId = responseObj.get("count");
	var reward = responseObj.get("brw");
	
	var resource = this.callFunction ("resource_parser", [reward]);
	
	var listObj = this.callFunction ("resource_to_obj", [reward, resource]);
	var gachaPanel = PixmaGame.notification.showMultiGachaPanel (listObj);
	gachaPanel.add (Label.create ("<p align=\"center\">Xin Chúc mừng\nBạn đã nhận quà thành công</p>", Fonts.DETAIL_YELLOW_30, 0, -400, Anchor.center_center));
	
	var receives = responseObj.get("counter");
	if (receives == null)
	{
		receives = [];
		receives [rewardId] = true;
		mapData.set ("receives", receives);
	}
	this.callFunction ("update");
	
	UserInfo.handleAddResourch (resource);
});

functionList.set ("resource_parser", function (reward)
{
	trace ("resource_parser: " + reward);
	var resource = ParseObject.toResourchInstance (reward);
	return resource;
});

functionList.set ("resource_to_obj", function (reward, resource)
{
	trace ("resource_to_obj");
	var resourceDesc = new ResourceDesc ();
	
	resourceDesc.rune = resource.rune;
	resourceDesc.tradableRune = resource.tradableRune;
	
	resourceDesc.gold = resource.gold;
	resourceDesc.fp = resource.fp;
	
	resourceDesc.ap = resource.ap;
	resourceDesc.redAp = resource.redAp;
	
	resourceDesc.exp = resource.exp;
	resourceDesc.armorsets = resource.armor;

	// resourceDesc.bonusCardSlots = resource.bonusCardSlots;
	
	var gameItems = resourceDesc.toGameItem ();
	if (gameItems == null) gameItems = [];
	
	if (resource.equi != null)
	{
		var equipments = new StringMap ();
		for (equipItemInfo in resource.equi)
		{
			if (equipItemInfo != null)
			{
				var numObj = equipments.get (equipItemInfo.prototypeId);
				if (numObj == null) numObj = {id:equipItemInfo.prototypeId, num:0};
				numObj.num += 1;
				equipments.set (equipItemInfo.prototypeId, numObj);
			}	
		}
		
		for (equipObj in equipments)
		{
			if (equipObj == null) continue;
			var id = equipObj.id;
			var num = equipObj.num;
			var equipItem = new GameItem (GameItemType.Equipment, id, num);
			gameItems.push (equipItem);
		}
	}
	
	if (resource.specialitem != null)
	{
		var listSItem = new StringMap ();
		for (specialItem in resource.specialitem)
		{
			var info = specialItem.info;
			if (info == null) continue;
			
			var oldNumber = this.callFunction ("item_count", [info.index]);
			var newNumber = specialItem.number;
			var num = newNumber - oldNumber;
			
			listSItem.set (info.index, {id:info.index, num:num});
		}
		
		for (specialObj in listSItem)
		{
			var specialItem = new GameItem (GameItemType.Special_Item, specialObj.id, specialObj.num);
			gameItems.push (specialItem);
		}
	}
	
	if (reward != null && reward.has("ar"))
	{
		var armor = new StringMap ();
		var fbArray = reward.get("ar");
		var iter = fbArray.getInteratorSet();
		while (iter.hasNext()) 
		{
			var armorId = iter.next();
			
			var numObj = armor.get (armorId);
			if (numObj == null) numObj = {id:armorId, num:0};
			numObj.num += 1;
			
			armor.set (armorId, numObj);
		}
		
		for (armorObj in armor)
		{
			var armorItem = new GameItem (GameItemType.Armor_Set, armorObj.id, armorObj.num);
			gameItems.push (armorItem);
		}
	}
	
	var itemObj = [];
	
	for (item in gameItems)
	{
		if (item == null) continue;
		var icon = this.callFunction ("gameItem_to_obj", [item, item.number, Fonts.DETAIL_WHITE_20]);
		itemObj.push (icon);
	}
	
	if (resource.card != null)
	{
		var resourceCard = new StringMap ();
		var normalCard = [];
		for (cardInfo in resource.card)
		{
			if (cardInfo == null) continue;
			if (cardInfo.isHero ())
				normalCard.push (cardInfo);
			else
			{
				var prototypeId = cardInfo.GetPrototypeId ();
				var array = resourceCard.get (prototypeId);
				if (array == null)
				{
					array = [];
					resourceCard.set (prototypeId, array);
				}
				
				array.push (cardInfo);
			}
		}
		
		for (cardInfo in normalCard)
		{
			var icon = this.callFunction ("cardInfo_to_obj", [cardInfo]);
			itemObj.push (icon);
		}
		
		for (cardGroup in resourceCard)
		{
			if (cardGroup.length == 0) continue;
			
			var icon = this.callFunction ("cardInfo_to_obj", [cardGroup [0]]);
			var number = Label.create (cardGroup.length, Fonts.DETAIL_WHITE_20, 0, 50, Anchor.center_top);
			number.name = "number";
			icon.add (number);
			itemObj.push (icon);
		}
	}
	
	return itemObj;
});

functionList.set ("gameItem_to_obj", function (gameItem, num, numFont)
{
	trace ("gameItem_to_obj: " + gameItem + ", " + num);
	var iconGroup = new Layer ();
	
	var icon = gameItem.getIcon ();
	icon.scaleX = icon.scaleY = 0.7;
	icon.name = "icon";
	iconGroup.add (icon);
	
	if (num != null && num != "")
	{
		if (numFont == null) numFont = Fonts.DETAIL_WHITE_20;
		var number = Label.create (num, numFont, 40, 0, Anchor.left_center);
		number.name = "number";
		iconGroup.add (number);
	}
	
	PixmaGame.notification.addHint (iconGroup, function (e)
	{
		return this.callFunction ("callItemHint", [e, gameItem, 320, e.stageY - 40]);
	});
	
	iconGroup.addEventListener (Event.REMOVED_FROM_STAGE, function (e)
	{
		PixmaGame.notification.removeHint (iconGroup);
	});
	
	return iconGroup;
});

functionList.set ("cardInfo_to_obj", function (cardInfo)
{
	var iconGroup = new Layer ();
	
	var icon = new SmallIcon (cardInfo, 0, 0, {type:0, levelMode:0});
	icon.name = "icon";
	iconGroup.add (icon);
	
	return iconGroup;
});

functionList.set ("arrange_gift", function (listObj)
{
	var row = Math.ceil (listObj.length / 5);
	var column = Math.min (5, listObj.length);
	var index = 0;
	var rowId = 0;
	var layer = new Layer ();
	
	while (rowId < row)
	{
		if (listObj.length - rowId * column < column)
			column = listObj.length - rowId * column;
		
		var columnId = 0;
		var offsetLength = (column - 1) * 0.5;
		while (columnId < column)
		{
			var icon = listObj [index];
			index ++;
			
			icon.x = (columnId - offsetLength) * 100;
			icon.y = rowId * 120;
			layer.add (icon);
			
			columnId ++;
		}
		rowId ++;
	}
	
	return layer;
});

return functionList;