		// if(frame != null)
			// m.box.removeChild(frame);
			
		// if(status == STATUS_EXPIRED)
		// {			
			// frame = evtSpr.GetFrame(1, 0, 0)
			// m.box.addChild(frame);
		// }else if(status == STATUS_CLAIMED)
		// {			
			// frame = evtSpr.GetFrame(2, 0, 0)
			// m.box.addChild(frame);
		// }
	// }
	return mission;
});

functionList.set ("getGiftItem", function (info)
{
	var type = info.type;
	var num = info.num;
	 	 
	var specialSpr = Resource.getSprite ("GFX_SPECIAL_ICON");
	var evtSpr = Resource.getSprite ("GFX_EVENT_NEWSERVER");
	var item = new DisplayObject();
	var label = Label.create ("x" + num, Fonts.TITLE_WHITE_20, 0, 5, Anchor.center_top);
	
	if(type == TYPE_AP)
		item.addChild(evtSpr.GetFrame(3, 0, 0));
	else if(type == TYPE_COIN)	
		item.addChild(evtSpr.GetFrame(4, 0, 0));
	else if(type == TYPE_XP2)
	{	
		item.addChild(evtSpr.GetFrame(5, 0, 0));
		label.text += " Ngày";
	}else if(type == TYPE_FP)	
		item.addChild(evtSpr.GetFrame(6, 0, 0));
	else if(type == TYPE_RUNE)	
		item.addChild(evtSpr.GetFrame(7, 0, 0));
	else if(type == TYPE_RANDOM_CARD)
	{	
		var frame = specialSpr.GetFrame(32, 0, -35);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}else if(type == TYPE_ARMORSET)	
	{	
		var frame = specialSpr.GetFrame(36, 0, -35);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}else if(type == TYPE_RANDOM_EQUIP)	
	{	
		var frame = specialSpr.GetFrame(41, 0, -35);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}
	
	label.Update();
	label.Render();
	item.addChild(label);
	return item;
});

//Type: 0 reward bình thường, 1: daily
functionList.set ("receiveDailyRewards", function (listreward, type){
	var request = new Request(3);
	var content = new FBObjectOutput();
	content.putString("cmd", "rewards");
	var arr = new FBArrayOutput();
	trace("Wil receive reward:");
	if (listreward != null)
	{
		for (item in listreward) {
			if(item.rw_type != RewardItemInfo.TYPE_RESTORE_AP)
			{
				arr.putInt(item.itemId);
				trace("id: " + item.itemId);
			}
		}
	}
	content.putArray("lit", arr);
	content.putInt("ty", type);
	request.setContent(content);
	return request;
});

functionList.set ("init", function ()
{
	Resource.loadSprite ("GFX_EVENT_NEWSERVER");
	var evtSpr = Resource.getSprite ("GFX_EVENT_NEWSERVER");

	var rewardHolder = new Layer ();
	rewardHolder.x = -320;
	rewardHolder.y = -95;
	this.add(rewardHolder);
	
	rewardHolder.add(new ColorRect (0xFF0000, 0.5, 0, 0, 640, 960));
	
	rewardHolder.add(Border.roundRect (0, 0, 0, 0, 640 , 960, 10, 1, 0xFFFFFF, 1, 0xFFFFFF));
	
	
	//bg event 2
	// rewardHolder.add(new ColorRect (0x022742, 1.0, 0, 0, 640, 960));	
	rewardHolder.add(new ColorRect (0x045CA3, 1.0, 0, 0, 640, 960));	
	
	var line = new ColorRect (0x000000, 1.0, 0, 0, 640, 5);
	line.y = 400;
	rewardHolder.add(line);
	
	//bg event 1
	// rewardHolder.add(new ColorRect (0x045CA3, 1.0, 0, 0, 640, 400));
	
	//header
	rewardHolder.add(new ColorRect (0x63C0E2, 1.0, 0, 0, 640, 70));	
	var label = Label.create ("Sự kiện máy chủ Huyền Thoại", Fonts.DETAIL_WHITE_30, 320, 10, Anchor.center_top);
	label.Update();
	label.Render();
	rewardHolder.add(label);
	
	//panel reward new comer
	rewardHolder.add(Border.roundRect (0, 0, 20, 180, 600 , 200, 10, 1, 0x0000000, 1, 0x022742));
	rewardHolder.add(Border.roundRect (0, 0, 20, 180 + 200 - 85, 600 , 85, 10, 1, 0x0000000, 1, 0x054477));
	
		
	//panel reward new comer 2
	rewardHolder.add(Border.roundRect (0, 0, 5, 380 + 135, 630 , 420, 10, 1, 0x0000000, 1, 0x022742));
	// rewardHolder.add(Border.roundRect (0, 0, 20, 180 + 200 - 85, 600 , 85, 10, 1, 0x0000000, 1, 0x054477));
	
	// ahri
	rewardHolder.add(evtSpr.GetFrame(0, 105, 140));	
	
	//title event 1
	rewardHolder.add(Label.create ("Quà Tân Thủ", Fonts.TITLE_WHITE_30, 380, 100, Anchor.center_center));
	
	var btnNewComer = this.callFunction ("getButtonGift", ["Nhận Quà", BTN_NORMAL]);
	btnNewComer.x = 380;
	btnNewComer.y = 150;
	rewardHolder.addChild(btnNewComer);
	
	trace("before 111111111");
	var data1 = this.callFunction ("getConstGiftEvent", [EVENT_NEWCOMER]);
	
	var total = data1.length; 
	var padding = 130;
	var startX = (640 - 600)/2 + (600-(total-1)*padding)/2;
	var i = 0;
	for(info in data1)
	{
		var obj = this.callFunction ("getGiftItem", [info]);
		obj.x = startX + i*padding;
		obj.y = 320;
		rewardHolder.addChild(obj);
		i++;
	}
	trace("data1 " + data1);
	var itemStatusArr = RewardItemInfo.GetDinamicListRewards();
	var filterRewardArr = itemStatusArr.filter(function(reward){
		for(info in data1)
			if(reward.itemId == info.id && info.status == STATUS_COMPLETED)
				return true;
		return false;
	});
	trace("filterRewardArr " + filterRewardArr);
	
	if(filterRewardArr.length == 0)
	{
		rewardHolder.removeChild(btnNewComer);
		var btn = this.callFunction ("getButtonGift", ["Đã Nhận", BTN_DISABLE]);
		btn.x = btnNewComer.x;
		btn.y = btnNewComer.y;
		rewardHolder.addChild(btn);
	}else
	{
		btnNewComer.addEventListener (MouseEvent.CLICK, function(e)
		{
			var	objArr = [];
			trace("get reward newcomer");
			PixmaGame._instance.fbClient.send (this.callFunction ("receiveDailyRewards", [filterRewardArr, 0]));
			PixmaGame._instance.fbClient.addEventListener(FBEvent.RECEIVE_REWARD, function (params)
				{					
					var obj = this.callFunction ("getItemReward", [params.get("type"), params.get("value")]);		objArr.push(obj);
				});
			PixmaGame._instance.fbClient.addEventListener(FBEvent.RECEIVE_MULTI_REWARD,function (params)
				{
					PixmaGame._instance.fbClient.removeEventListener (FBEvent.RECEIVE_REWARD);
					PixmaGame._instance.fbClient.removeEventListener (FBEvent.RECEIVE_MULTI_REWARD);
					for(reward in filterRewardArr)
						RewardItemInfo.finish_recieve_rewards.push(reward.itemId);
					var mes = params.get("mes");
					trace("mes " + mes);
					rewardHolder.removeChild(btnNewComer);
					var btn = this.callFunction ("getButtonGift", ["Đã Nhận", BTN_DISABLE]);
					btn.x = btnNewComer.x;
					btn.y = btnNewComer.y;
					rewardHolder.addChild(btn);
					
					var popup = this.callFunction ("callPopup", [mes, rewardHolder]);
					var i = 0;
					var w = 100;
					var length = objArr.length;
					var startX = -(w*(length-1))/2;
					for(obj in objArr)
					{
						obj.x = startX + i * w;
						obj.y = 80 ;
						popup.addChild(obj);
						i++;
					}
				});
		});
	}	
		
	//title event 2
	rewardHolder.add(Label.create ("Nhiệm Vụ Tân Thủ", Fonts.TITLE_WHITE_30, 20, 435, Anchor.left_center));
	
	rewardHolder.add(Label.create ("* Mỗi ngày hoàn thành nhiệm vụ để nhận quà", Fonts.TITLE_WHITE_20, 20, 470, Anchor.left_center));
	var questLabel = Label.create ("* Nhiệm vụ ngày hôm nay:", Fonts.TITLE_WHITE_20, 20, 500, Anchor.left_center);
	//button 7 days	
	var data2 = this.callFunction ("getConstGiftEvent", [EVENT_MISSION7DAYS]);
	trace("data2 " + data2);
	var curDate = this.callFunction ("getCurrentDateEvent", []);
	for(q in data2)
	{
		if((q.day.getTime() - curDate.getTime()) >= 0)
		{
			questLabel = Label.create ("* Nhiệm vụ ngày hôm nay: " + q.quest, Fonts.TITLE_WHITE_20, 20, 500, Anchor.left_center);
			break;
		}
	}
	questLabel.Update();
	questLabel.Render();
	rewardHolder.add(questLabel);
	
	var table = [4,3];
	var w = 140;
	var h = 140;	
	var h2 = 35;
	var padding = 20;
	
	var j = 0;
	var count = 0;
	var missionArr = [];
	var findMission = function(box)
	{
		trace("findMission box " + box);
		for(m in missionArr)
			if(m.box == box)
				return m;
		trace("nothing");
		return null;
	}
	
	for(row in table)
	{
		var total = row;
		var startX = (640-total*w - (total-1)*padding)/2 + w/2;
		var i = 0;
		while(i < total)
		{
			var info = data2[count];
			trace("1111111111");
			var mission = this.callFunction ("getButtonMission", [info, w, h, h2]);
			missionArr.push(mission);
			mission.box.x = startX + (w+padding)*i;
			mission.box.y = 600 + (h+60)*j;
			trace("mission.box.y");
			this.callFunction ("SetStatusMission", [mission, info.status]);
			trace("his.callFunction ");
			mission.box.addEventListener (MouseEvent.CLICK, function(e)
				{
					var mission = findMission(e.currentTarget);	
					trace("findMission mission " +mission);					
					if(mission != null)
					{
						if(mission.info.status == STATUS_COMPLETED)
						{
							// var type = mission.info.reward.type;
							// var itemId = mission.info.reward.itemId;
							// PixmaGame._instance.fbClient.send (RequestGennarator.receiveDailyReward (itemId, type));	
							var	objArr = [];
							PixmaGame._instance.fbClient.send (this.callFunction ("receiveDailyRewards", [[mission.info.reward], 0]));
							PixmaGame._instance.fbClient.addEventListener(FBEvent.RECEIVE_REWARD, function (params)
								{
									this.callFunction ("SetStatusMission", [mission, STATUS_CLAIMED]);				
									RewardItemInfo.finish_recieve_rewards.push(mission.info.reward.itemId);
									var obj = this.callFunction ("getItemReward", [params.get("type"), params.get("value")]);									
									objArr.push(obj);
								});
							// PixmaGame._instance.fbClient.addEventListener(FBEvent.RECEIVE_REWARD_ERROR, function (params)
								// {
									// var msg = params.get("msg");
									// if(msg != null)
										// this.callFunction ("callPopup", [msg, rewardHolder]);
								// });
							PixmaGame._instance.fbClient.addEventListener(FBEvent.RECEIVE_MULTI_REWARD,function (params)
								{
									PixmaGame._instance.fbClient.removeEventListener (FBEvent.RECEIVE_REWARD);
									PixmaGame._instance.fbClient.removeEventListener (FBEvent.RECEIVE_MULTI_REWARD);
									var mes = params.get("mes");
									trace("mes " + mes);
									this.callFunction ("SetStatusMission", [mission, STATUS_CLAIMED]);
									
									var popup = this.callFunction ("callPopup", [mes, rewardHolder]);
									var i = 0;
									var w = 100;
									var length = objArr.length;
									var startX = -(w*(length-1))/2;
									for(obj in objArr)
									{
										obj.x = startX + i * w;
										obj.y = 80 ;
										popup.addChild(obj);
										i++;
									}
								});
						}else if(mission.info.status == STATUS_WAITGET)
							this.callFunction ("callPopup", ["Bạn chưa hoàn thành nhiệm vụ này!", rewardHolder]);				
					}		
				});
				
			rewardHolder.add(mission.box);
			trace(i+ " x " + mission.box.x + " y " + mission.box.y);
			
			i++;
			count++;
		}
		j++;
	}
	
	// this.close_btn = new Button (SoftDefines.gfx_main_ui, DF_UI.anim_tab_close_normal, DF_UI.anim_tab_close_touch);
	var closeBtn = this.callFunction ("getCloseButton", []);
	
	closeBtn.x = 280;
	closeBtn.y = -60;
	closeBtn.addEventListener (MouseEvent.CLICK, this.onBackUp);
	this.add (closeBtn);
});

return functionList;