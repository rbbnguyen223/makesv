	box.addChild(Label.create("Ngày " + info.day.getDate() + "-" + (info.day.getMonth()+1), Fonts.TITLE_WHITE_20, 0, -55, Anchor.center_center));
	var obj = this.callFunction ("getGiftItem", [info]);
	obj.y = 40;
	box.addChild(obj);
	
	var btn = this.callFunction ("getButtonGift", ["Nhận Quà", BTN_NORMAL]);
