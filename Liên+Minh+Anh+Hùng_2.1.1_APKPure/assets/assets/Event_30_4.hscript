var functionList = new FunctionList ();
var eventSprite = null;
var mapObj = null;
var mapData = null;
var constant = null;
var trade = null;

functionList.set ("init", function ()
{
	trace ("call init");
	trace("initttttttttt: 9" );
	//this.callFunction ("callHotfix");
	
	eventSprite = Resource.getSprite ("GFX_EVENT_30_4", true);
	mapObj = new StringMap ();
	mapData = new StringMap ();
	trace("initttttttttt: 8" );
	constant = this.callFunction ("init_constant");
	
	if (PixmaGame.notification != null)
	{
		PixmaGame.notification.flyControl.x = 50;
		PixmaGame.notification.flyControl.y = 310;
	}
	
	var mainLayer = new Layer ();
	var mainHeight = 960;
	var starHeight = 460 + 70 - 17;
	
	var background = new ColorRect (0x053446, 1, 0, starHeight, 640, mainHeight - starHeight + 5);
	mainLayer.add (background);
	trace("initttttttttt: 7" );
	var star = this.callFunction ("initStar");
	star.y = 70 - 17;
	star.name = "star";
	mainLayer.add (star);
	
	var titleBg = new ColorRect (0x053446, 1, 0, 0, 640, 70 - 17);
	mainLayer.add (titleBg);
	
	var title = eventSprite.GetFrame (DF_EVENT.FRAME_TITLE);
	mainLayer.add (title);
	trace("initttttttttt: 6" );
	var closeBtn = this.callFunction ("getCloseButton", [615, 30]);
	closeBtn.name = "closeBtn";
	closeBtn.addEventListener (MouseEvent.CLICK, function (e) { this.releaseFromParent (); });
	mainLayer.add (closeBtn);
	trace("initttttttttt: 5" );
	var tabs = this.callFunction ("initTabs");
	tabs.name = "tabs";
	mainLayer.add (tabs);
	
	var resetBtn = new Button (SoftDefines.gfx_main_ui, DF_UI.anim_popup_button, DF_UI.anim_popup_button + 1, DF_UI.anim_popup_button);
	resetBtn.x = 100 - 30 + 15 + 15;
	resetBtn.y = 300 + 65 + 100;
	resetBtn.name = "resetBtn";
	resetBtn.visible = false;
	resetBtn.set_label (Label.create ("Chơi Lại", Fonts.DETAIL_WHITE_20, 0, 0, Anchor.center_center));
	trace("initttttttttt: 4" );
	resetBtn.addEventListener (MouseEvent.CLICK, function (e)
	{
		this.callFunction ("callResetPopup");
	});
	mapObj.set ("resetBtn", resetBtn);
	mainLayer.add (resetBtn);
	trace("initttttttttt: 3" );
	var gift = this.callFunction ("initGift", [mainHeight - starHeight]);
	gift.y = starHeight + 50;
	gift.name = "gift";
	mainLayer.add (gift);
	
	mainLayer.x = -320;
	mainLayer.y = -100;
	
	mapObj.set ("mainLayer", mainLayer);
	this.add (mainLayer);
	trace("initttttttttt: 2" );
	this.callFunction ("initData");	
	trace("initttttttttt: 1" );
	this.callFunction ("request_info", [EVENT_ID]);
	trace("initttttttttt: 0" );
	PixmaGame._instance.fbClient.addEventListener("EVENT_SCRIPT_REQUEST_newevent", function (params)
	{
		this.callFunction ("response", [params]);
	});
	trace("initttttttttt: -1" );
});

functionList.set ("initData", function ()
{
	var request = [5, 5, 5, 5, 5];
	mapData.set ("request", request);
	
	this.callFunction ("updateGems");
	this.callFunction ("updatePiece");
	this.callFunction ("updateColumn", [0]);
	this.callFunction ("updateColumn", [1]);
	this.callFunction ("updateColumn", [2]);
	this.callFunction ("updateColumn", [3]);
	this.callFunction ("updateColumn", [4]);
	this.callFunction ("updateCombo");
	this.callFunction ("updateReset");
});

