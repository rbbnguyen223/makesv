functionList.set ("callShop", function ()
{
	trace ("callShop ");
	var eventSprite = Resource.getSprite ("GFX_EVENT_30_4", true);
	
	var layer = new Layer ();
	
	var titleLb = Label.create ("Kho Ngọc", Fonts.DETAIL_BLACK_30, 0, -125, Anchor.center_center);
	layer.add (titleLb);
	
	var index = 0;
	var numLbs = new StringMap ();
	for (gemId in GEMS)
	{
		var gemLayer = new Layer ();
		gemLayer.x = (index - 2) * 107;
		
		var bg = Border.roundRect (0, 0, -50, -65, 100, 145, 20, 2, 0x000000, 1, 0xFFFFFF, 1);
		gemLayer.add (bg);
		
		var icon = eventSprite.GetFrame (DF_EVENT.FRAME_PINK_GEM - GEM_PINK + gemId);
		icon.y = -30;
		gemLayer.add (icon);
		
		var num = this.callFunction ("item_count", [gemId]);
		var numLb = Label.create (num, Fonts.CHAT_BLACK_20, 0, 0, Anchor.center_top);
		gemLayer.add (numLb);
		numLbs.set (gemId, numLb);
		
		var buyBtn = new Button (SoftDefines.gfx_list_item, DF_LISTITEM.anim_confirm_normal, DF_LISTITEM.anim_confirm_touch, DF_LISTITEM.anim_confirm_disable);
		buyBtn.y = 55;
		buyBtn.m_id = gemId;
		buyBtn.set_label (Label.create ("Mua", Fonts.DETAIL_BLACK_20, 0, 0, Anchor.center_center));
		buyBtn.addEventListener (MouseEvent.CLICK, function (e)
		{
			this.callFunction ("callBuyGems", [buyBtn.m_id, 1, function ()
			{
				var lb = numLbs.get (buyBtn.m_id);
				if (lb != null) lb.set_text (this.callFunction ("item_count", [buyBtn.m_id]));
			}]);
		});
		gemLayer.add (buyBtn);
		
		layer.add (gemLayer);
		index += 1;
	}
	
	this.callFunction ("callPopup", [layer, "mainLayer"]);
});

functionList.set ("callBuyGems", function (gemId, number, callback)
{
	var gemInfo = SpecialItemInfo.get (gemId);
	if (gemInfo == null) return;
	
	var shopItemData = gemInfo.getShopItem ();
	if (shopItemData == null) return;
	
	ShopUtilities.callBuyPopup (shopItemData, number, function (params)
	{
		if (callback != null) callback ();
		this.callFunction ("updateGems");
	});
});

