	var chooseTargetLayer = null;
	
	var layer = new Layer ();
	layer.add (titleLb);
	layer.add (hintLb);
	layer.add (srcLayer);
	srcLayer.add (srcBg);
	srcLayer.add (srcIcon);
	srcLayer.add (srcNumber);
	layer.add (plusSign);
	layer.add (goldIcon);
	layer.add (goldNumber);
	layer.add (eqSign);
	layer.add (targetLayer);
	targetLayer.add (targetBg);
	targetLayer.add (targetIcon);
	targetLayer.add (targetNumber);
	layer.add (increaseBtn);
	layer.add (decreaseBtn);
	layer.add (closeBtn);
	layer.add (confirmBtn);

	var popup = this.callFunction ("callPopup", [layer, "mainLayer"]);
	var popupBackground = popup.getChildByName ("background");
	if (popupBackground != null)
	{
		popupBackground.y -= 190;
		popup.y += 190;
	}
	
	var basePrice = 0;
	var price = 0;
	var onChange = false;
	
	var func_basePrice = function (src, target)
	{
		if (trade.get (src) != null)
			basePrice = trade.get (src).get (target);
		if (basePrice == null)
			basePrice = 0;
	};
	
	var func_setNum = function (newNumber)
	{
		number = Math.max (1, newNumber);
		price = basePrice * number;
		
		srcNumber.set_text (number);
		if (this.callFunction ("item_count", [srcId]) < number)
			srcNumber.set_textFormat (Fonts.DETAIL_RED_20);
		else
			srcNumber.set_textFormat (Fonts.DETAIL_BLACK_20);
		
		goldNumber.set_text (price);
		if (UserInfo.coin < price)
			goldNumber.set_textFormat (Fonts.DETAIL_RED_20);
		else
			goldNumber.set_textFormat (Fonts.DETAIL_BLACK_20);
		
		targetNumber.set_text (number);
	};
	
	var func_changeTarget = function (newTarget)
	{
		if (targetId == newTarget) return;
		
		targetId = newTarget;
		targetIcon.set_data (eventSprite.GetFrameData (DF_EVENT.FRAME_PINK_GEM - GEM_PINK + targetId));
		
		func_basePrice (srcId, targetId);
		func_setNum (1);
	};
	
	var func_changeSrc = function (nextSrc)
	{
		if (srcId == nextSrc) return;
		
		srcId = nextSrc;
		srcIcon.set_data (eventSprite.GetFrameData (DF_EVENT.FRAME_PINK_GEM - GEM_PINK + srcId));
		
		if (srcId == targetId)
		{
			var targetIndex = GEMS.indexOf (targetId) + 1;
			if (targetIndex >= GEMS.length) targetIndex = 0;
			var newTarget = GEMS [targetIndex];
		
			func_changeTarget (newTarget);
		}
		else
		{
			func_basePrice (srcId, targetId);
			func_setNum (1);
		}
	};
	
	var func_callChangeSrcLayer = function ()
	{
		onChange = true;
		popup.remove (chooseTargetLayer);
		chooseSrcLayer = this.callFunction ("callMenu", [srcLayer.x - 60, -30, "Chọn Ngọc", srcId, GEMS, function (gemId)
		{
			onChange = false;
			func_changeSrc (gemId);
			popup.remove (chooseSrcLayer);
		}]);
		
		popup.add (chooseSrcLayer);
	};
	
	var func_callChangeTargetLayer = function ()
	{
		var listId = [];
		for (gemId in GEMS)
		{
			if (gemId == srcId) continue;
			listId.push (gemId);
		}
		
		onChange = true;
		popup.remove (chooseSrcLayer);
		chooseTargetLayer = this.callFunction ("callMenu", [targetLayer.x - 60, -30, "Chọn Ngọc", targetId, listId, function (gemId)
		{
			onChange = false;
			func_changeTarget (gemId);
			popup.remove (chooseTargetLayer);
		}]);
		
		popup.add (chooseTargetLayer);
	};
	
	var func_hideChange = function ()
	{
		if (onChange)
		{
			popup.remove (chooseSrcLayer);
			popup.remove (chooseTargetLayer);
			onChange = false;
			return true;
		}
		return false;
	};
	
	var func_callTrade = function ()
	{	
		var errorMsg = null;
		var errorBtn = null;
		
		var gemNum = this.callFunction ("item_count", [srcId]);
		if (gemNum < number)
		{
			var gemInfo = SpecialItemInfo.get (srcId);
			if (gemInfo == null)
				errorMsg = "Không đủ ngọc để đổi.";
			else
				errorMsg = "Bạn cần thêm " + (number - gemNum) + " " + gemInfo.name + " để đổi.";

			if (this.callFunction ("gem_canBuy", [srcId]))
			{
				errorBtn = new Button (SoftDefines.gfx_main_ui, DF_UI.anim_popup_button, DF_UI.anim_popup_button + 1, DF_UI.anim_popup_button);
				errorBtn.x = 0;
				errorBtn.y = 100;
				errorBtn.set_label (Label.create ("Mua Thêm", Fonts.DETAIL_WHITE_20, 0, 0, Anchor.center_center));
				errorBtn.addEventListener (MouseEvent.CLICK, function (e)
				{
					this.callFunction ("callBuyGems", [srcId, number - gemNum, function ()
					{
						func_setNum (number);
					}]);
				});
			}
		}
		else if (UserInfo.coin < price)
		{
			errorMsg = "Bạn cần " + price + " tiền vàng để đổi.";
			
			errorBtn = new Button (SoftDefines.gfx_main_ui, DF_UI.anim_popup_button, DF_UI.anim_popup_button + 1, DF_UI.anim_popup_button);
			errorBtn.x = 0;
			errorBtn.y = 100;
			errorBtn.set_label (Label.create ("Mua Thêm", Fonts.DETAIL_WHITE_20, 0, 0, Anchor.center_center));
			errorBtn.addEventListener (MouseEvent.CLICK, function (e)
			{
				var pack = (price - UserInfo.coin) / 30000;
				ShopUtilities.buy (1, 4, Math.max (1, Math.ceil (pack / 30000)), function (params)
				{
					func_setNum (number);
				});
			});
		}
		
		if (errorMsg == null)
		{
			// popup.dispatchEvent (new Event (Event.CLOSE));
			this.callFunction ("request_change", [EVENT_ID, srcId, targetId, number]);
		}
		else
		{
			var errorPopup = this.callFunction ("callError", [errorMsg, "mainLayer"]);
			if (errorBtn != null)
			{
				errorBtn.addEventListener (MouseEvent.CLICK, function (e)
				{
					errorPopup.dispatchEvent (new Event (Event.CLOSE));
				});
				errorPopup.add (errorBtn);
			}
		}
	};
	
	srcLayer.addEventListener (MouseEvent.CLICK, function (e) { func_callChangeSrcLayer (); });
	targetLayer.addEventListener (MouseEvent.CLICK, function (e) { func_callChangeTargetLayer (); });
	increaseBtn.addEventListener (MouseEvent.CLICK, function (e) { if (func_hideChange ()) return; func_setNum (number + 1); });
	decreaseBtn.addEventListener (MouseEvent.CLICK, function (e) { if (func_hideChange ()) return; func_setNum (number - 1); });
	confirmBtn.addEventListener (MouseEvent.CLICK, function (e) { if (func_hideChange ()) return; func_callTrade (); });
	
	func_basePrice (srcId, targetId);
	func_setNum (number);
});

functionList.set ("callError", function (errorMsg, parent)
{
	var title = Label.create ("Cảnh Báo", Fonts.DETAIL_BLACK_30, 0, -80, Anchor.center_center);
	var msg = Label.create ("<p align=\"center\">" + errorMsg + "</p>", Fonts.DETAIL_BLACK_20, 0, -40, Anchor.center_center, 500);
	
	var popup = new Layer ();
	popup.add (title);
	popup.add (msg);
	
	this.callFunction ("callPopup", [popup, parent]);
});

functionList.set ("callMenu", function (x, y, title, currentId, listGemsId, callback)
{
	var layer = new Layer (x, y);
	
	var titleBg = Border.roundRect (0, -30, 0, 0, 120, 27 + listGemsId.length * 60, 10, 2, 0x000000, 1, 0x000000, 1);
	layer.add (titleBg);
	
	var title = Label.create (title, Fonts.DETAIL_WHITE_20, 60, -17, Anchor.center_center);
	layer.add (title);
	
	var index = 0;
	for (gemId in listGemsId)
	{
		var gemLayer = new Layer ();
		gemLayer.x = 3;
		gemLayer.y = 27 + index * 60;
		gemLayer.m_id = gemId;
		
		var gemBg = Border.roundRect (0, 0, 0, -27, 114, 54, 10, 1, 0xFFFFFF, 1, 0xFFFFFF, 1);
		gemBg.m_id = gemId;
		gemBg.alpha = (gemBg.m_id == currentId) ? 0.95 : 0.8;
		gemLayer.add (gemBg);
		
		var gemIcon = eventSprite.GetFrame (DF_EVENT.FRAME_PINK_GEM - GEM_PINK + gemId);
		gemIcon.x = 25;
		gemIcon.set_scale (0.8);
		gemLayer.add (gemIcon);
		
		var num = this.callFunction ("item_count", [gemId]);
		var gemNum = Label.create (num, Fonts.DETAIL_BLACK_20, 113, 0, Anchor.right_center);
		gemLayer.add (gemNum);
		
		gemLayer.addEventListener (MouseEvent.MOUSE_OVER, function (e) { gemBg.alpha = 1; });
		gemLayer.addEventListener (MouseEvent.MOUSE_OUT, function (e) { gemBg.alpha = (gemBg.m_id == currentId) ? 0.95 : 0.8; });
		gemLayer.addEventListener (MouseEvent.CLICK, function (e) { callback (gemLayer.m_id); });
		
		layer.add (gemLayer);
		index ++;
	}
	
	return layer;
});

functionList.set ("callItemHint", function (e, gameItem, x, y)
{
	trace ("callItemHint");
	if (gameItem == null) return;
	
	var name = gameItem.toString ();
	var desc = [];
	
	if (gameItem.type == GameItemType.Equipment)
	{
		var equipInfo = EquipInfo.GetEquip (gameItem.index);
		if (equipInfo != null)
		{
			for (pro in equipInfo.get_list_properties (0))
			{
				equipPDesc = "";
				desc.push (pro.desc);
			}
		}
	}
	else if (gameItem.type == GameItemType.Special_Item)
	{
		var item = SpecialItemInfo.get (gameItem.index);
		name = item.name;
		
		if (item.desc != null && item.desc != "")
			desc.push (item.desc);
	}
	
	var text = name;
	for (d in desc) text += "\n" + d;
	
	var hint = new Hint (x, y, text, Anchor.center_bottom, 520);
	return hint;
});

functionList.set ("item_count", function (itemId)
{
	return StockManager.countSpecialItem (itemId);
});

functionList.set ("request_script", function (requestObj)
{
	var request = RequestGennarator.scriptRequest("newevent", requestObj);
	PixmaGame._instance.fbClient.send (request);
});

functionList.set ("response", function (params)
{
	trace ("response: " + params);
	var data = params.get("data");
	
	var cmd = data.get("cmd");
	trace ("response: " + cmd);
	if (cmd == "info")
		this.callFunction ("response_info", [data]);
	else if (cmd == "evolSI")
		this.callFunction ("response_evolve", [data]);
	else if (cmd == "receive")
		this.callFunction ("response_receice", [data]);
	else if (cmd == "receiveCombo")
		this.callFunction ("response_receiceCombo", [data]);
	else if (cmd == "changeSI")
		this.callFunction ("response_change", [data]);
	 else if (cmd == "reset")
		 this.callFunction ("response_reset", [data]);
});

