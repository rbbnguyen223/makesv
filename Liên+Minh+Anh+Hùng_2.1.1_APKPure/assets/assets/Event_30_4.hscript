functionList.set ("response_evolve", function (responseObj)
{
	trace ("response_evolve: " + responseObj.toString ());
	
	if (responseObj.has("emess")){
		var errorMsg = responseObj.get("emess");
		this.callFunction ("callError", [errorMsg, "mainLayer"]);
		return;
	}
	
	var itemId = responseObj.get("id");
	var eventId = responseObj.get("evd");
	var index = PIECES.indexOf (itemId);
	
	var flyingObj = null;
	if (responseObj.has("brw"))
	{
		var reward = responseObj.get("brw");
		var resource = this.callFunction ("resource_parser", [reward]);
		var listObj = this.callFunction ("resource_to_obj", [reward, resource]);
		
		UserInfo.handleAddResourch (resource);
		
		for (itemObj in listObj)
		{
			if (itemObj == null) continue;
			var icon = itemObj.getChildByName ("icon");
			if (icon != null) icon.set_scale (0.5);
			
			var number = itemObj.getChildByName ("number");
			if (number != null) number.y = 25;
			
			flyingObj = new FlyingObject (360, 240, -3, 5, 15);
			flyingObj.add (itemObj);
		}
	}
	
	if (index != -1) this.callFunction ("piece_combine_effect", [index, flyingObj]);
});

