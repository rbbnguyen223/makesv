			{id:4906, itemId:69,  num:50, armor:true, rewards:[{type: 15, id: 10063, num: 1},{type: 15, id: 10042, num: 2},{type: 6, id: 227, num: 1},{type: 15, id: 38, num: 1},{type: 2, id: -1, num: 300000},{type: 1, id: -1, num: 300}]},
			{id:4907, itemId:69,  num:65, armor:true, rewards:[{type: 15, id: 10064, num: 1},{type: 15, id: 10042, num: 2},{type: 6, id: 228, num: 1},{type: 15, id: 38, num: 2},{type: 2, id: -1, num: 500000},{type: 1, id: -1, num: 500}]},
			{id:4908, itemId:69,  num:85, armor:true, rewards:[{type: 15, id: 10060, num: 1},{type: 15, id: 10042, num: 2},{type: 6, id: 229, num: 1},{type: 15, id: 38, num: 4},{type: 2, id: -1, num: 1000000},{type: 1, id: -1, num: 1000}]}
		],
		comboCounter:[
			{
				id:0,
				required:[4504,4604,4704,4804,4904],
				rewards:[{type: 0, id: -1, num: 2000}]
			},
			{
				id:1,
				required:[4505,4605,4705,4805,4905],
				rewards:[{type: 15, id: 3, num: 20}]
			},
			{
				id:2,
				required:[4506,4606,4706,4806,4906],
				rewards:[{type: 4, id: 1379, num: 25}]
			},
			{
				id:3,
				required:[4507,4607,4707,4807,4907],
				rewards:[{type: 0, id: -1, num: 4000}]
			},
			{
				id:4,
				required:[4508,4608,4708,4808,4908],
				rewards:[{type: 15, id: 38, num: 10}]
			}
		],
		resets:[
			[{itemId:65, num:105}, {itemId:66, num:105}, {itemId:67,num:105}, {itemId:68, num:105}, {itemId:69, num:105}],
			[{itemId:65, num:115}, {itemId:66, num:115}, {itemId:67,num:115}, {itemId:68, num:115}, {itemId:69, num:115}],
			[{itemId:65, num:135}, {itemId:66, num:135}, {itemId:67,num:135}, {itemId:68, num:135}, {itemId:69, num:135}],
			[{itemId:65, num:155}, {itemId:66, num:155}, {itemId:67,num:155}, {itemId:68, num:155}, {itemId:69, num:155}],
			[{itemId:65, num:185}, {itemId:66, num:185}, {itemId:67,num:185}, {itemId:68, num:185}, {itemId:69, num:185}]
		],
		limitReset:0
	};
	
	var constant = {};
	constant.columns = [];
	constant.combo = [];
	
	var index = 0;
	while (index < PIECES.length)
	{
		constant.columns [index] = [];
		index += 1;
	}
	
	var gifts = temp.counter;
	var numGifts = gifts.length;
	for (obj in gifts)
	{
		var pieceId = obj.itemId - PIECE_PINK;
		constant.columns [pieceId].push (obj);
	}
	
	var index = 0;
	while (index < PIECES.length)
	{
		constant.columns [index].sort (function (a, b)
		{
			if (a.id > b.id) return 1;
			if (a.id < b.id) return -1;
			return 0;
		});
		
		index += 1;
	}
	
	var comboList = temp.comboCounter;
	for (comboObj in comboList)
	{
		var giftId = comboObj.required [0];
		for (column in constant.columns)
		{
			var rowIndex = 0;
			while (rowIndex < column.length)
			{
				if (giftId == column [rowIndex].id)
				{
					constant.combo [rowIndex] = comboObj;
					numGifts += 1;
					break;
				}
				rowIndex += 1;
			}
		}
	}
	
	var tradeTemp = [
		{id:GEM_YELLOW, gold:[
			{id:GEM_PINK, value:10000},
			{id:GEM_GREEN, value:8000},
			{id:GEM_BLUE, value:8500},
			{id:GEM_RED, value:10000},
		]},
		{id:GEM_PINK, gold:[
			{id:GEM_YELLOW, value:8000},
			{id:GEM_BLUE, value:8000},
			{id:GEM_RED, value:8000},
			{id:GEM_GREEN, value:8000},
		]},
		{id:GEM_GREEN, gold:[
			{id:GEM_YELLOW, value:8500},
			{id:GEM_BLUE, value:9000},
			{id:GEM_RED, value:10500},
			{id:GEM_PINK, value:10500},
		]},
		{id:GEM_BLUE, gold:[
			{id:GEM_YELLOW, value:8000},
			{id:GEM_GREEN, value:8000},
			{id:GEM_RED, value:9000},
			{id:GEM_PINK, value:9000},
		]},
		{id:GEM_RED, gold:[
			{id:GEM_YELLOW, value:8000},
			{id:GEM_PINK, value:8000},
			{id:GEM_GREEN, value:8000},
			{id:GEM_BLUE, value:8000},
		]},
	];
	
	trade = new StringMap ();
	for (group in tradeTemp)
	{
		var groupMap = new StringMap ();
		var gold = group.gold;
		for (price in gold) groupMap.set (price.id, price.value);
		
		trade.set (group.id, groupMap);
	}
	
	constant.numGifts = numGifts;
	
	trace ("done");
	return constant;
});

functionList.set ("initTabs", function ()
{
	var tabs = new Layer ();
	tabs.x = 30;
	tabs.y = 100;
	
	var infoBtn = new Button (SoftDefines.gfx_comboui, DF_COMBOUI.anim_tabv_normal, DF_COMBOUI.anim_tabv_selected);
	infoBtn.y = 0;
	infoBtn.set_label (eventSprite.GetFrame (DF_EVENT.FRAME_INFO_ICON));
	infoBtn.addEventListener (MouseEvent.CLICK, function (e)
	{
		this.callFunction ("callInfo");
	});
	tabs.add (infoBtn);
	
	var shopBtn = new Button (SoftDefines.gfx_comboui, DF_COMBOUI.anim_tabv_normal, DF_COMBOUI.anim_tabv_selected);
	shopBtn.y = 58;
	shopBtn.set_label (eventSprite.GetFrame (DF_EVENT.FRAME_SHOP_ICON));
	shopBtn.addEventListener (MouseEvent.CLICK, function (e)
	{
		this.callFunction ("callShop");
	});
	tabs.add (shopBtn);
	
	var tradeBtn = new Button (SoftDefines.gfx_comboui, DF_COMBOUI.anim_tabv_normal, DF_COMBOUI.anim_tabv_selected);
	tradeBtn.y = 116;
	tradeBtn.set_label (eventSprite.GetFrame (DF_EVENT.FRAME_CHANGE_ICON));
	tradeBtn.addEventListener (MouseEvent.CLICK, function (e)
	{
		this.callFunction ("callTrade", [GEM_PINK, GEM_GREEN, 1]);
	});
	tabs.add (tradeBtn);
	
	return tabs;
});

functionList.set ("initStar", function ()
{
	trace ("initStar");
	var star = new Layer ();
	var gemLbOffset = [];
	gemLbOffset [0] = {x:0, y:30, anchor:Anchor.center_top};
	gemLbOffset [1] = {x:-30, y:0, anchor:Anchor.right_center};
	gemLbOffset [2] = {x:-20, y:-20, anchor:Anchor.right_bottom};
	gemLbOffset [3] = {x:20, y:-20, anchor:Anchor.left_bottom};
	gemLbOffset [4] = {x:30, y:0, anchor:Anchor.left_center};
	
	var backgroundLayer = new Layer ();
	star.add (backgroundLayer);
	
	var effectLayer = new Layer ();
	star.add (effectLayer);
	mapObj.set ("effectLayer", effectLayer);
	
	var itemLayer = new Layer ();
	star.add (itemLayer);
	
	backgroundLayer.add (eventSprite.GetFrame (DF_EVENT.FRAME_BACKGROUND));
	
	var index = 0;
	var angle90 = (MATH_PI / 2);
	while (index < 5)
	{
		var angle = ((index * 2 * MATH_PI) / 5);
		
		var edge1 = eventSprite.GetFrame (DF_EVENT.FRAME_STAR_EDGE);
		if (PixmaGame.isFlash)
			edge1.rotation = (index * 72) + 90 - 54;
		else
			edge1.set_rotation ((index * 72) + 90 - 54);
		edge1.x = centerX + Math.cos (angle + angle90) * radiusGem;
		edge1.y = centerY + Math.sin (angle + angle90) * radiusGem;
		backgroundLayer.add (edge1);
		
		var edge2 = eventSprite.GetFrame (DF_EVENT.FRAME_STAR_EDGE);
		if (PixmaGame.isFlash)
			edge2.rotation = (index * 72) + 90 + 54;
		else
			edge2.set_rotation ((index * 72) + 90 + 54);
		edge2.x = edge1.x;
		edge2.y = edge1.y;
		backgroundLayer.add (edge2);
	
		var piece = eventSprite.GetFrame (DF_EVENT.FRAME_PINK_PIECE + index);
		piece.x = centerX + Math.cos (angle - angle90) * radiusPiece;
		piece.y = centerY + Math.sin (angle - angle90) * radiusPiece;
		piece.m_id = index;
		piece.addEventListener (MouseEvent.CLICK, function (e)
		{
			this.callFunction ("piece_onClick", [piece.m_id]);
		});
		itemLayer.add (piece);
	
		var gemId = (index + 3) % 5;
		var gem = eventSprite.GetFrame (DF_EVENT.FRAME_PINK_GEM + gemId);
		gem.x = edge1.x;
		gem.y = edge1.y;
		gem.m_id = GEMS [gemId];
		
		var gemLb = Label.create (" ", Fonts.CHAT_WHITE_20, gemLbOffset[index].x, gemLbOffset[index].y, gemLbOffset[index].anchor);
		gemLb.name = "gemLb";
		gem.addChild (gemLb);
		
		gem.addEventListener (MouseEvent.CLICK, function (e)
		{
			this.callFunction ("callBuyGems", [gem.m_id, 1, function ()
			{
				var lb = gem.getChildByName ("gemLb");
				if (lb != null) lb.set_text (this.callFunction ("item_count", [gem.m_id]));
			}]);
		});
		
		itemLayer.add (gem);
		
		trace ("mapObj: " + (mapObj == null));
		
		mapObj.set ("star_gem_" + gemId + "_lb", gemLb);
		mapObj.set ("star_gem_" + gemId, gem);
		
		index += 1;
	}
	
	trace ("done");
	return star;
});

functionList.set ("initGift", function (height)
{
	trace ("initGift");
	var gift = new Layer ();
	var slotLayer = new Layer ();
	
	var giftProcessLayer = new Layer ();
	var scrollHeight = height - 100 + 10;
	var scrollView = new PageScrollable (giftProcessLayer, 640, scrollHeight, 2);
	scrollView._inertialScrolling = true;
	scrollView.y = 100 / 2 - 5;
	
	var columnId = 0;
	var giftboxLocation = new StringMap ();
	var maxLength = 0;
	while (columnId < constant.columns.length)
	{
		var mainSlot = eventSprite.GetFrame (DF_EVENT.FRAME_PINK_SLOT + columnId);
		mainSlot.x = 50 + columnId * 108;
		mainSlot.y = 0;
		
		var pieceInfo = SpecialItemInfo.get (PIECES [columnId]);
		if (pieceInfo != null)
		{
			var pieceGameItem = new GameItem (GameItemType.Special_Item, PIECES [columnId], 0);
			PixmaGame.notification.addHint (mainSlot, function (e)
			{
				return this.callFunction ("callItemHint", [e, pieceGameItem, 320, 320 + 180]);
			});
			
			mainSlot.addEventListener (Event.REMOVED_FROM_STAGE, function (e)
			{
				PixmaGame.notification.removeHint (mainSlot);
			});
		}
		
		var mainSlotLb = Label.create (" ", Fonts.DETAIL_YELLOW_20, 0, 50, Anchor.center_bottom);
		mapObj.set ("star_piece_" + columnId + "_lb", mainSlotLb);
		mainSlot.addChild (mainSlotLb);
		
		slotLayer.add (mainSlot);
		
		var rowId = 0;
		var columnData = constant.columns [columnId];
		maxLength = Math.max (maxLength, columnData.length);
		while (rowId < columnData.length)
		{
			var giftObj = columnData [rowId];
			var giftbox = eventSprite.GetFrame (DF_EVENT.FRAME_GRAY_GIFT);
			giftbox.x = 50 + columnId * 108;
			giftbox.y = 70 + rowId * 100;
			giftbox.name = "giftbox_" + columnId + "_" + rowId;
			giftbox.addEventListener (MouseEvent.CLICK, function (e)
			{
				this.callFunction ("giftbox_onClick", [e]);
			});
			
			var giftboxStatus = Label.create (" ", gift_red_font, GIFT_BOX_LB_X, GIFT_BOX_LB_Y, Anchor.left_top);
			mapObj.set ("giftbox_status_" + columnId + "_" + rowId, giftboxStatus);
			giftbox.addChild (giftboxStatus);
			
			giftProcessLayer.add (giftbox, 0);
			mapObj.set (giftbox.name, giftbox);
			giftboxLocation.set (giftObj.id, {row:rowId, column:columnId});
			
			rowId += 1;
		}
		columnId += 1;
	}
	
	mapData.set ("giftboxLocation", giftboxLocation);
	
	var rowId = 0;
	var comboData = constant.combo;
	while (rowId < comboData.length)
	{
		var comboGift = comboData [rowId];
		if (comboGift == null)
		{
			rowId += 1;
			continue;
		}
		
		var combo = eventSprite.GetFrame (DF_EVENT.FRAME_GRAY_COMBO);
		combo.x = 50 + 5 * 108;
		combo.y = 70 + rowId * 100;
		combo.name = "combo_" + rowId;
		combo.addEventListener (MouseEvent.CLICK, function (e)
		{
			this.callFunction ("combo_onClick", [e]);
		});
		
		var tempLb = Label.create ("=", Fonts.DETAIL_WHITE_30, -70 + 15, 0, Anchor.center_center);
		tempLb.mouseEnabled = false;
		combo.addChild (tempLb);
		
		var addSign = 0;
		while (4 > addSign ++)
		{
			tempLb = Label.create ("+", Fonts.DETAIL_WHITE_30, -68 + 15 - addSign * 108, 0, Anchor.center_center);
			tempLb.mouseEnabled = false;
			combo.addChild (tempLb);
		}
		
		giftProcessLayer.add (combo, 0);
		mapObj.set (combo.name, combo);
		
		rowId += 1;
	}
	
	var floor = new DisplayObject (0,50 + maxLength * 100);
	floor.getGraphics ().beginFill (0x000000, 0);
	floor.getGraphics ().drawRect (0, 0, 640, 10);
	floor.getGraphics ().endFill ();
	giftProcessLayer.add (floor);
	
	var colors = [0x053446, 0x053446];
	var alphas = [1, 0];
	var ratios = [0, 255];
	var matrix = new Matrix();
	matrix.createGradientBox (640, 40, 0.5 * MATH_PI, 0, 0);
	
	var	top = new DisplayObject ();
	top.y = 100 / 2 - 5;
	top.mouseEnabled = false;
	if (GradientType != null)
	{
		top.getGraphics ().beginGradientFill (GradientType.LINEAR, colors, alphas, ratios, matrix);
		top.getGraphics ().drawRect (0, 0, 640, 40);
		top.getGraphics ().endFill ();
	}
	matrix = new Matrix();
	matrix.createGradientBox (640, 40, -0.5 * MATH_PI, 0, 0);
	
	var	bottom = new DisplayObject ();
	bottom.y = scrollView.y + scrollHeight - 40;
	bottom.mouseEnabled = false;
	if (GradientType != null)
	{
		bottom.getGraphics ().beginGradientFill (GradientType.LINEAR, colors, alphas, ratios, matrix);
		bottom.getGraphics ().drawRect (0, 0, 640, 40);
		bottom.getGraphics ().endFill ();
	}
	
	gift.add (scrollView);
	gift.add (top);
	gift.add (slotLayer);
	gift.add (bottom);
	return gift;
});

functionList.set ("initInfo", function ()
{
});

functionList.set ("initShop", function ()
{
	
});

functionList.set ("initAnim", function (index)
{
	trace ("initAnim");
	var indexLeft = this.callFunction ("piece_leftGem", [index]);
	var indexRight = this.callFunction ("piece_rightGem", [index]);
	
	var gemLeft = mapObj.get ("star_gem_" + indexLeft);
	var gemRight = mapObj.get ("star_gem_" + indexRight);
	
	var animLayer = new Layer ();
	trace ("animLayer: " + animLayer);
	
	var center = eventSprite.GetAnim (DF_EVENT.ANIM_PIECE, 0, 0, false);
	var angle = (index * 0.4 - 0.5) * MATH_PI;
	center.x = centerX + Math.cos (angle) * radiusPieceAnim;
	center.y = centerY + Math.sin (angle) * radiusPieceAnim;
	trace ("center: " + center);
	if (PixmaGame.isFlash)
		center.rotation = index * 72;
	else
		center.set_rotation (index * 72);

	trace ("center: " + center);
	center.addEventListener ("ANIM_STOP", function (e)
	{
		animLayer.remove (center);
		animLayer.dispatchEvent (new Event ("STOP"));
	});
	
	var left = eventSprite.GetAnim (DF_EVENT.ANIM_GEM, 0, 0, false);
	left.x = gemLeft.x;
	left.y = gemLeft.y;
	animLayer.add (left);

	trace ("left: " + left);
	
	var right = eventSprite.GetAnim (DF_EVENT.ANIM_GEM, 0, 0, false);
	right.x = gemRight.x;
	right.y = gemRight.y;
	animLayer.add (right);

	trace ("right: " + right);
	
	var stop2 = function (e)
	{
		animLayer.remove (left);
		animLayer.remove (right);
		animLayer.add (center);
	};

	trace ("stop2: " + stop2);
	
	var stop1 = null;
	var maxTime = 3;
	var time = 0;
	stop1 = function (e)
	{
		if (time == 0)
		{
			right.removeEventListener ("ANIM_STOP", stop1);
		
			left.set_animData (eventSprite.GetAnimData (DF_EVENT.ANIM_LINE));
			if (PixmaGame.isFlash)
				left.rotation = (indexLeft * 72) - 90 + 108;
			else
				left.set_rotation ((indexLeft * 72) - 90 + 108);
			
			right.set_animData (eventSprite.GetAnimData (DF_EVENT.ANIM_LINE));
			if (PixmaGame.isFlash)
				right.rotation = (indexRight * 72) - 90;
			else
				right.set_rotation ((indexRight * 72) - 90);
		}
		
		left.x = gemLeft.x;
		left.y = gemLeft.y;
		left.set_scale (1.5);
		left.Play (true, true);
		Actuate.tween (left, 0.3 * (maxTime - time) / maxTime, {x:center.x, y:center.y, scaleX:1, scaleY:1});
		
		right.x = gemRight.x;
		right.y = gemRight.y;
		right.set_scale (1.5);
		right.Play (true, true);
		Actuate.tween (right, 0.3 * (maxTime - time) / maxTime, {x:center.x, y:center.y, scaleX:1, scaleY:1}).onComplete (time < maxTime ? stop1 : stop2, [e]);
		
		time ++;
	};
	
	trace ("stop1: " + stop1);
	
	right.addEventListener ("ANIM_STOP", stop1);
	
	trace ("Anim done");
	return animLayer;
});

functionList.set ("updateGems", function ()
{
	trace ("updateGems");
	var request = mapData.get ("request");
	
	var gemId = 0;
	while (gemId < GEMS.length)
	{
		var label = mapObj.get ("star_gem_" + gemId + "_lb");
		
		if (label != null)
		{
			var gem = this.callFunction ("gem_get_number", [gemId]);
			label.set_text (gem + "/" + request [gemId]);
			
			if (request [gemId] > gem)
				label.set_textFormat (gem_red_font);
			else
				label.set_textFormat (gem_green_font);
				
			label.Update ();
		}
		
		gemId ++;
	}
});

functionList.set ("updatePiece", function ()
{
	trace ("updatePiece");
	
	var pieceId = 0;
	while (pieceId < PIECES.length)
	{
		var label = mapObj.get ("star_piece_" + pieceId + "_lb");
		
		if (label != null)
		{
			var piece = this.callFunction ("piece_get_number", [pieceId]);
			label.set_text (piece);
			label.Update ();
		}
		
		pieceId ++;
	}
});

functionList.set ("updateColumn", function (pieceId)
{
	trace ("updateColumn");
	var giftId = 0;
	var giftLength = 10;
	var numberPiece = this.callFunction ("piece_get_number", [pieceId]);
	var columnData = constant.columns [pieceId];
	var status = [];

	var comboMark = mapData.get ("comboMark");
	if (comboMark == null)
	{
		comboMark = [];
		mapData.set ("comboMark", comboMark);
	}
	
	if (comboMark [pieceId] == null)
		comboMark [pieceId] = [];
	
	while (giftId < columnData.length)
	{
		var giftbox = mapObj.get ("giftbox_" + pieceId + "_" + giftId);
		var giftboxStatus = mapObj.get ("giftbox_status_" + pieceId + "_" + giftId);
		
		if (giftbox == null) break;
		var giftObj = null;
		if (constant.columns [pieceId] != null)	
			giftObj = constant.columns [pieceId][giftId];
		
		var requestPiece = columnData [giftId].num;
		var isComplete = numberPiece >= requestPiece;
		var isGot = false;
		var max = -1;
		var isArmor = false;
		
		if (giftObj != null)
		{
			isArmor = giftObj.armor;
			isGot = this.callFunction ("giftbox_isGot", [giftObj.id]);
		}
		
		giftboxStatus.set_text (requestPiece);
		giftboxStatus.set_textFormat (isComplete ? gift_green_font : gift_red_font);
		giftboxStatus.Update ();
		
		comboMark [pieceId][giftId] = isComplete;
		if (isArmor)
		{
			if (isComplete)
			{
				if (isGot)
					giftbox.set_data (eventSprite.GetFrameData (DF_EVENT.FRAME_PINK_ARMOR_GOT + pieceId));
				else
					giftbox.set_data (eventSprite.GetFrameData (DF_EVENT.FRAME_PINK_ARMOR + pieceId));
				
				max = pieceId;
			}
			else
			{
				if (giftId - 1 == max)
					giftbox.set_data (eventSprite.GetFrameData (DF_EVENT.FRAME_PINK_ARMOR + pieceId));
				else
					giftbox.set_data (eventSprite.GetFrameData (DF_EVENT.FRAME_PINK_ARMOR_GRAY + pieceId));
			}
		}
		else
		{
			if (isComplete)
			{
				if (isGot)
					giftbox.set_data (eventSprite.GetFrameData (DF_EVENT.FRAME_PINK_GOT + pieceId));
				else
					giftbox.set_data (eventSprite.GetFrameData (DF_EVENT.FRAME_PINK_GIFT + pieceId));
				
				max = pieceId;
			}
			else
			{
				if (giftId - 1 == max)
					giftbox.set_data (eventSprite.GetFrameData (DF_EVENT.FRAME_PINK_GIFT + pieceId));
				else
					giftbox.set_data (eventSprite.GetFrameData (DF_EVENT.FRAME_GRAY_GIFT));
			}
		}
		giftId += 1;
	}
});

functionList.set ("updateCombo", function ()
{
	trace ("updateCombo");
	var comboMark = mapData.get ("comboMark");
	if (comboMark == null) return;
	if (constant.combo == null) return;
	
	var comboId = 0;
	var comboLength = constant.combo.length;
	
	while (comboId < comboLength)
	{
		var comboObj = constant.combo [comboId];
		// trace ("combo [" + comboId + "]: " + comboObj);
		if (comboObj == null)
		{
			comboId += 1;
			continue;
		}
		
		var isComplete = true;
		for (giftId in comboObj.required)
		{
			var gift_isGot = this.callFunction ("giftbox_isGot", [giftId]);
			isComplete = isComplete && gift_isGot;
		}
		
		var isGot = this.callFunction ("combo_isGot", [comboObj.id]);
		
		var combo = mapObj.get ("combo_" + comboId);
		if (combo != null)
		{
			if (isGot)
				combo.set_data (eventSprite.GetFrameData (DF_EVENT.FRAME_COMBO_GOT));
			else if (isComplete)
				combo.set_data (eventSprite.GetFrameData (DF_EVENT.FRAME_COMBO));
			else
				combo.set_data (eventSprite.GetFrameData (DF_EVENT.FRAME_GRAY_COMBO));
		}
		
		comboId += 1;
	}
});

functionList.set ("updateReset", function ()
{
	var canShowReset = this.callFunction ("canShowReset");
	var resetBtn = mapObj.get ("resetBtn");
	if (resetBtn != null)
		resetBtn.visible = canShowReset == true;
});

functionList.set ("gem_get_number", function (gemId)
{
	return this.callFunction ("item_count", [GEMS [gemId]]);
});

functionList.set ("gem_canBuy", function (gemId)
{
	var gemInfo = SpecialItemInfo.get (gemId);
	if (gemInfo == null) return;
	
	var shopItemData = gemInfo.getShopItem ();
	return shopItemData != null;
});

functionList.set ("piece_leftGem", function (index)
{
	return index % 5;
});

functionList.set ("piece_rightGem", function (index)
{
	return (index + 1) % 5;
});

functionList.set ("piece_check", function (index)
{
	trace ("piece_check: " + index);
	var indexLeft = this.callFunction ("piece_leftGem", [index]);
	
	var indexRight = this.callFunction ("piece_rightGem", [index]);
	
	var request = mapData.get ("request");
	
	var gemLeft = this.callFunction ("gem_get_number", [indexLeft]);
	if (request [indexLeft] > gemLeft)
		return GEMS [indexLeft];
		
	var gemRight = this.callFunction ("gem_get_number", [indexRight]);
	if (request [indexRight] > gemRight)
		return GEMS [indexRight];
	
	return -1;
});

functionList.set ("piece_onClick", function (index)
{
	trace ("piece_onClick: [" + index + "]: " + PIECES [index]);
	
	var check = this.callFunction ("piece_check", [index]);
	if (check == -1)
	{
		this.callFunction ("request_evolve", [EVENT_ID, PIECES [index], 1]);
		return;
	}
	
	var gemInfo = SpecialItemInfo.get (check);
	if (gemInfo != null)
	{
		var errorMsg = "Bạn thiếu " + gemInfo.name;
		PixmaGame.notification.addFlyingText (360, 300, errorMsg);
	}
});

functionList.set ("piece_combine_effect", function (index, flyingObj)
{
	trace ("piece_combine_effect");
	var effectLayer = mapObj.get ("effectLayer");
	
	var animLayer = this.callFunction ("initAnim", [index]);
	animLayer.addEventListener ("STOP", function (e)
	{
		effectLayer.remove (animLayer);
		
		this.callFunction ("updateGems");
		this.callFunction ("updatePiece");
		this.callFunction ("updateColumn", [index]);
		this.callFunction ("updateCombo");
		
		trace ("flyingObj: " + flyingObj);
		if (flyingObj != null) PixmaGame.notification.add (flyingObj);
	});
	
	trace ("effectLayer: " + effectLayer);
	effectLayer.add (animLayer);
	trace ("animLayer: " + animLayer);
});

functionList.set ("piece_get_number", function (pieceId)
{
	return this.callFunction ("item_count", [PIECES [pieceId]]);
});

functionList.set ("giftbox_get_require", function (pieceId, giftId)
{
	var requests = [5, 10, 15, 25, 40, 65, 105, 170, 275, 445];
	return requests [giftId];
});

functionList.set ("giftbox_location", function (giftId)
{
	var giftboxLocation = mapData.get ("giftboxLocation");
	if (giftboxLocation == null)
	return false;
	return giftboxLocation.get (giftId);
});

functionList.set ("giftbox_isComplete", function (giftId)
{
	trace ("giftbox_isComplete");
	var location = this.callFunction ("giftbox_location", [giftId]);
	if (location == null || constant.column == null) return false;
	
	var giftObj = constant.column [location.column][location.row];
	if (giftObj == null) return false;
	var numberPiece = this.callFunction ("item_count", PIECES [location.column]);
	return giftObj.num < current;
});

functionList.set ("giftbox_isGot", function (giftId)
{
	var giftReceived = mapData.get ("giftReceived");
	if (giftReceived == null)
	return false;
	return giftReceived.indexOf (giftId) != -1;
});

functionList.set ("giftbox_onClick", function (e)
{
	trace ("giftbox_onClick");
	if (e == null) return;
	if (e.currentTarget == null) return;
	
	var giftbox = e.currentTarget;
	var param = giftbox.name.split ("_");
	var pieceId = Std.parseInt (param [1]);
	var giftId = Std.parseInt (param [2]);
	
	var giftObj = null;
	if (constant.columns [pieceId] != null)	
		giftObj = constant.columns [pieceId][giftId];
	
	if (giftObj == null) return;
	
	var current = this.callFunction ("item_count", [giftObj.itemId]);
	var target = giftObj.num;
	var isGot = this.callFunction ("giftbox_isGot", [giftObj.id]);
	
	var pieceInfo = SpecialItemInfo.get (giftObj.itemId);
	var namePiece = pieceInfo == null ? ("mảnh sao " + pieceId) : pieceInfo.name;
	
	if (target > current)
	{
		var title = "Tích lũy " + target + " " + namePiece + " để nhận";
		this.callFunction ("callGiftPopup", [title, giftObj.rewards, "mainLayer"]);
	}
	else if (isGot)
	{
		var title = "Bạn đã nhận gói quà này!";
		this.callFunction ("callGiftPopup", [title, giftObj.rewards, "mainLayer"]);
	}
	else
	{
		this.callFunction ("request_receice", [EVENT_ID, giftObj.id]);
	}
});

functionList.set ("combo_onClick", function (e)
{
	trace ("combo_onClick");
	if (e == null) return;
	if (e.currentTarget == null) return;
	if (constant.combo == null) return;
	
	var combo = e.currentTarget;
	var param = combo.name.split ("_");
	var comboId = Std.parseInt (param [1]);
	var comboObj = constant.combo [comboId];
	
	if (comboObj == null) return;
	var isComplete = true;
	for (giftId in comboObj.required)
	{
		var gift_isGot = this.callFunction ("giftbox_isGot", [giftId]);
		isComplete = isComplete && gift_isGot;
	}
	
	var isGot = this.callFunction ("combo_isGot", [comboObj.id]);
	
	if (!isComplete)
	{
		var title = "Nhận 5 gói tích lũy để nhận quà";
		this.callFunction ("callGiftPopup", [title, comboObj.rewards, "mainLayer"]);
	}
	else if (isGot)
	{
		var title = "Bạn đã nhận gói quà này!";
		this.callFunction ("callGiftPopup", [title, comboObj.rewards, "mainLayer"]);
	}
	else
	{
		this.callFunction ("request_receiceCombo", [EVENT_ID, comboObj.id]);
	}
});

functionList.set ("combo_isComplete", function (comboId)
{
	return false;
});

functionList.set ("combo_isGot", function (comboId)
{
	var comboReceived = mapData.get ("comboReceived");
	if (comboReceived == null)
	return false;
	return comboReceived.indexOf (comboId) != -1;
});

functionList.set ("canReset", function ()
{
	trace ("canReset: ");
	if (constant == null) return;
	
	var numGifts = constant.numGifts;
	if (numGifts == null || numGifts < 0) return;
	
	var numReceived = 0;
	
	var giftReceived = mapData.get ("giftReceived");
	if (giftReceived != null && giftReceived.length != null)
		numReceived += giftReceived.length;
	
	var comboReceived = mapData.get ("comboReceived");
	if (comboReceived != null && comboReceived.length != null)
		numReceived += comboReceived.length;
		
	trace ("numGifts: " + numGifts);
	trace ("numReceived: " + numReceived);
		
	return numReceived >= numGifts;
});

functionList.set ("canShowReset", function ()
{
	trace ("canShowReset: ");
	if (constant == null) return;
	if (constant.columns == null) return;
	
	var countPieces = new StringMap ();
	for (pieceId in PIECES)
		countPieces.set (pieceId, this.callFunction ("item_count", [pieceId]));
	
	trace ("countPieces: " + countPieces);
	
	var countGift = 0;
	var countCompleteGift = 0;
	for (column in constant.columns)
	{
		if (column == null) continue;
		for (gift in column)
		{
			//trace ("gift " + gift);
			if (gift == null) continue;
			
			countGift += 1;
			
			var current = countPieces.get (gift.itemId);
			var complete = gift.num <= current;
			if (complete == true)
				countCompleteGift += 1;
			
			//trace ("gift [" + gift.itemId + ", " + gift.id + "]: " + current + "/" + gift.num + " >> " + complete);
		}
	}
	
	trace ("countGift: " + countGift);
	trace ("countCompleteGift: " + countCompleteGift);
	return countCompleteGift == countGift;
});

functionList.set ("getCloseButton", function (x, y)
{
	trace ("getCloseButton");
	var closeBtn = new DisplayObject (x, y);
	var graphic = closeBtn.getGraphics();
	graphic.clear ();
	graphic.lineStyle (1.5, 0xFFFFFF, 1.0);
	graphic.beginFill (0x000000, 0.5);
	graphic.drawCircle (0, 0, 24);
	graphic.endFill ();
	
	graphic.lineStyle (3, 0xFFFFFF, 1.0);
	graphic.moveTo (-10, -10);
	graphic.lineTo (10, 10);
	graphic.moveTo (10, -10);
	graphic.lineTo (-10, 10);
	
	return closeBtn;
});

functionList.set ("callPopup", function (content, parent)
{
	var w = 550;
	var h = 300;
	
	var popup = new Layer();
	popup.x = 320;
	popup.y = 480;
	
	var parentObj = null;
	if (Std.is (parent, DisplayObject))
		parentObj = parent;
	else if (Std.is (parent, String))
	{
		var unknow = mapObj.get (parent);
		if (Std.is (unknow, DisplayObject))
			parentObj = unknow;
	}
	
	var background = new ColorRect(0x000000, 0.5, -320, -480, 640, 960);
	background.name = "background";
	background.addEventListener (MouseEvent.CLICK, function (e) { parentObj.remove (popup); });
	popup.addChild (background);
	
	var closeBtn = this.callFunction ("getCloseButton", [245, -120]);
	closeBtn.addEventListener (MouseEvent.CLICK, function (e) { popup.dispatchEvent (new Event (Event.CLOSE)); });
	popup.addChild (closeBtn);

	popup.addEventListener (Event.CLOSE, function (e) { parentObj.remove (popup); });
	
	var addHeight = 0;
	if (content != null)
	{
		if (Std.is (content, String))
		{
			var label = Label.create (content, Fonts.DETAIL_BLACK_20, 0, 0, Anchor.center_center);
			popup.add (label);
		}
		else if (Std.is (content, DisplayObject))
		{
			popup.add (content);
			var bound = content.getBounds (popup);
			if (bound.bottom > h / 2) addHeight = bound.bottom - h * 0.5 + 20;
		}
	}
	
	popup.addChildAt (Border.roundRect (0, 0, -w * 0.5, -h * 0.5, w, h + addHeight, 30, 2, 0x555555, 1, 0xFFFFFF), 1);
	
	parentObj.add (popup);
	return popup;
});

functionList.set ("callGiftPopup", function (title, rewards, parent)
{
	var titleLb = Label.create (title, Fonts.DETAIL_BLACK_20, 0, -80, Anchor.center_center);
	
	var rewardObjs = [];
	for (reward in rewards)
	{
		var gameItem = new ShopItem (reward.type, reward.id);
		var iconObj = this.callFunction ("gameItem_to_obj", [gameItem, reward.num, Fonts.DETAIL_BLACK_20]);
		
		var icon = iconObj.getChildByName ("icon");
		if (icon != null) icon.set_scale (0.8);
		
		var number = iconObj.getChildByName ("number");
		if (number != null) number.y = 35;
		
		rewardObjs.push (iconObj);
	}
	var giftLayer = this.callFunction ("arrange_gift", [rewardObjs]);
	
	var layer = new Layer ();
	layer.add (titleLb);
	layer.add (giftLayer);
	
	this.callFunction ("callPopup", [layer, parent]);
});

functionList.set ("callResetPopup", function ()
{
	trace ("callResetPopup");
	var temp = mapData.get ("resetPrice");
	if (temp == null) return;
	
	var resetPrice = [];
	var index = 0;
	while (index < temp.length)
	{
		var obj = {itemId:temp [index], num:temp [index + 1]};
		index += 2;
		resetPrice.push (obj);
	}
	trace ("resetPrice: " + resetPrice);
	
	var titleLb = Label.create ("Xác Nhận", Fonts.DETAIL_BLACK_30, 0, -125, Anchor.center_center);
	var descLb = Label.create ("Bạn có muốn dùng mảnh sao để reset sự kiện không?", Fonts.CHAT_BLACK_20, 0, -95, Anchor.center_top, 520);
	
	var priceObjs = [];
	var canReset = this.callFunction ("canReset");
	var missRequire = false;
	for (price in resetPrice)
	{
		var gameItem = new GameItem (GameItemType.Special_Item, price.itemId);
		var count = this.callFunction ("item_count", [price.itemId]);
		
		var iconBg = Border.roundRect (0, 0, -45, -45 + 10, 90, 90, 10, 3, 0xEEEEEE, 1, 0x222222, 1);
		var iconPrice = this.callFunction ("gameItem_to_obj", [gameItem, count + "/" + price.num, Fonts.DETAIL_BLACK_20]);
		
		var icon = iconPrice.getChildByName ("icon");
		if (icon != null) icon.set_scale (0.8);
		
		var number = iconPrice.getChildByName ("number");
		if (number != null)
		{
			if (count < price.num)
			{
				number.set_textFormat (gem_red_font);
				missRequire = true;
			}
			else
				number.set_textFormat (gem_green_font);
			
			number.y = 30;
		}
		
		var iconLayer = new Layer ();
		iconLayer.add (iconBg);
		iconLayer.add (iconPrice);
		
		priceObjs.push (iconLayer);
	}
	var priceLayer = this.callFunction ("arrange_gift", [priceObjs]);
	
	var confirmBtn = new Button (SoftDefines.gfx_main_ui, DF_UI.anim_popup_button, DF_UI.anim_popup_button + 1, DF_UI.anim_popup_button);
	confirmBtn.x = 0;
	confirmBtn.y = 100;
	confirmBtn.set_label (Label.create ("Reset", Fonts.DETAIL_WHITE_20, 0, 0, Anchor.center_center));
	
	var layer = new Layer ();
	layer.add (titleLb);
	layer.add (descLb);
	layer.add (priceLayer);
	layer.add (confirmBtn);
	
	var popup = this.callFunction ("callPopup", [layer, "mainLayer"]);
	
	confirmBtn.addEventListener (MouseEvent.CLICK, function (e)
	{
		if (!canReset)
		{
			this.callFunction ("callError", ["\n\nBạn chưa nhận hết quà!", "mainLayer"]);
			return;
		}
		
		if (missRequire)
		{
			this.callFunction ("callError", ["\n\nBạn không đủ tài nguyên\nđể thực hiện thao tác này!", "mainLayer"]);
			return;
		}
		
		popup.dispatchEvent (new Event (Event.CLOSE));
		this.callFunction ("request_reset", [EVENT_ID]);
	});
	
});

