			var plusPercent = 0;
			var plusTotalPercent = 0;
			var guildBuff =  GuildBuff.GetBuff(guildTrophy);
			if(guildBuff!= null)
				plusPercent += guildBuff.powerBuff;
			
			var rebirthData = RebirthUser.getRebirthData(rebirthRank);
			if (rebirthData !=  null) {
				plusPercent += rebirthData.buff.atk_pt/10 ; 
			}
			plusPoint += call ("get_equi_power", [cardInfo,1,1,1,2]) ;
			plusPercent 	+= call ("get_equi_power", [cardInfo,1,1,2,2]) ;	
			plusTotalPercent = call ("get_max_equi_power", [cardInfo, 5,1,2,2]);
			
			var plusDamage = plusPoint + baseDamage*plusPercent/10000;
			plusDamage += (plusDamage + baseDamage)*plusTotalPercent/10000;
			return Std_int(plusDamage);
		
	});
