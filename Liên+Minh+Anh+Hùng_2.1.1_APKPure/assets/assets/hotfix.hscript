functionList.set ("overrideSprite", function (src, target)
{
	var srcId = Resource.getSpriteId (src);
	var srcContent = Resource.contents [srcId];
	if (srcContent == null) return;
	
	var targetId = Resource.getSpriteId (target);
	if (targetId < 0) return;
	
	srcContent.index = targetId;
	Resource.contents [targetId] = srcContent;
});

functionList.set ("overrideSkin", function (protypeId, skinIndex, skinSprite)
{
	var prototype = CardPrototypeInfo.GetItem (protypeId);
	if (prototype == null) return;
	if (prototype.skins == null)
		prototype.skins = [];
		
	var spriteId = Resource.getSpriteId (skinSprite);
	if (spriteId < 0) return;
	
	prototype.skins [skinIndex] = spriteId;
});

functionList.set ("fix_event_script", function ()
{
	PixmaGame._instance.fbClient.addEventListener("EVENT_SCRIPT_REQUEST", 
		function (params)
		{
			var data = params.get ("data");
			if (data == null) return;
			
			var cmd = data.get("scriptCMD");
			PixmaGame._instance.fbClient.dispatchEvent (new FBEvent ("EVENT_SCRIPT_REQUEST_" + cmd, params));
		}
	);
});

functionList.set ("fix_piggy", function ()
{
	var FeatureControl = Type.resolveClass ("FeatureControl");
	if (SoftDefines.BUILD_VERSION != "2.1.0")
	{
		FeatureControl.set ("G6_PIG", true, 1);
		return;
	}
	
	if (PixmaGame.isIos)
	{
		FeatureControl.set ("G6_PIG", true, 1);
	}
});

return functionList;