var shootanim = Resource.getSprite(spriteId).GetAnim (castAnim, attacker.xOri, attacker.yOri, false, renderMode);
// shootanim.useBlendMode = true;
sCurLayer.add(shootanim);
var shooteffect = new SimulateAnimEffect(attacker.GetDisplayCard(), shootanim, 330);
shooteffect.Init();
shooteffect.SetEffectListener(function (arr) 
							{
								sCurLayer.remove(shootanim);
							});
sCurState.AddScript(shooteffect);

var endEffect = [];
var hitAnimArray = [];
var setcb = true;
for(card in defender)
{		
	var arrow = Resource.getSprite(spriteId).GetAnim(travAnim, attacker.xOri, attacker.yOri, true, renderMode);	
	arrow.SetRotate(AngleBetweenCards(attacker, card) + 90);
	arrow.SetOpacity(0);
	// arrow.useBlendMode = true;
	sCurLayer.add(arrow);	
	
	var showeff = new OpacityEffect(arrow, 1, 50, null);
	showeff.Init();
	sCurState.AddScript(showeff);
	
	var meff = new MovingEffect(arrow, card.xOri - attacker.xOri,card.yOri - attacker.yOri, 500, null);
	meff.SetEffectListener(OnFinishHideEffect);
	meff.Init();
	sCurState.AddScript(meff);
	
	var arrowAnim = new AnimEffect(false, arrow, 1100, null, false);
	arrowAnim.Init();
	sCurState.AddScript(arrowAnim);	
	
	showeff.SetTimeDuration(10);
	meff.SetTimeDuration(1100);
	
	var hitAnim = Resource.getSprite(spriteId).GetAnim (hitAnim, card.xOri, card.yOri, false, renderMode);
	if (GameStateCardBattle.rotateBattle)
		hitAnim.rotation = -90;
	if(card.isBoss)
		hitAnim.Scale(GameStateCardBattle.SCALE_RATIO_NORMAL_BOSS, GameStateCardBattle.SCALE_RATIO_NORMAL_BOSS);
	
	var anim = new SimulateAnimEffect(card.GetDisplayCard(), hitAnim, 666, meff);			
	anim.AddEffectListener(function (arr)
					{
						sCurLayer.remove(hitAnim);
					});
	anim.Init();
	
	meff.AddEffectListener(function (arr)
					{
						sCurState.RemoveScript(arrowAnim);	
						sCurLayer.add(hitAnim);
						Sound.GetSound(sound).Play();
					});
	sCurState.AddScript(anim);
	if(setcb == true)
	{
		var nextstep = true;
		anim.AddCallbackPerUpdate(function (arr){
						if(anim.TimeRemaining() < waitTime && nextstep)
						{
							sCurState.nextStep = true;
							nextstep = false;
						}
					});
		setcb = false;
	}
	
	endEffect.push(anim);
}
return endEffect;