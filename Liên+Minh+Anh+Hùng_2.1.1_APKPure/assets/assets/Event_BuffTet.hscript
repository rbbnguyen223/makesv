functionList.set ("getGiftItem", function (info)
{
	trace("getGiftItem info " + info);
	var type = info.type;
	var desc = info.desc;
	 	 
	var specialSpr = Resource.getSprite ("GFX_SPECIAL_ICON");
	var evtSpr = Resource.getSprite ("GFX_EVENT_GENERAL_ITEM");
	var item = new DisplayObject();
	var font15 = new TextFormat (Fonts.CHAT_FONT, 15, 0x000000);
	var label = Label.create (desc, font15, 0, 10, Anchor.center_top, 170);
	
	if(type == TYPE_AP)
	{
		var frame = evtSpr.GetFrame(3, 0, -10);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}else if(type == TYPE_COIN)	
	{
		var frame = evtSpr.GetFrame(4, 0, -10);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}
	else if(type == TYPE_XP2)
	{	
		item.addChild(evtSpr.GetFrame(5, 0, 0));
		label.text += " Ngày";
	}else if(type == TYPE_FP)	
	{
		var frame = evtSpr.GetFrame(6, 0, -10);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}else if(type == TYPE_RUNE)	
	{
		var frame = evtSpr.GetFrame(7, 0, -10);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}else if(type == TYPE_RANDOM_CARD)
	{	
		var frame = specialSpr.GetFrame(30 + info.type_card, 0, -35);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}
	else if(type == TYPE_CARD)
	{	
		var card = new CardInfo(info.id_card, "123");
		var cardIcon = new SmallIcon (card, 0, -35, {type:0, levelMode:0, scale:0.8});
		item.addChild(cardIcon);
	}else if(type == TYPE_ARMORSET)	
	{	
		var frame = specialSpr.GetFrame(35 + info.type_armor, 0, -35);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}else if(type == TYPE_RANDOM_EQUIP)	
	{	
		var frame = specialSpr.GetFrame(40 + info.type_equip, 0, -35);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}else if(type == TYPE_EQUIP_ITEM)	
	{	
		var frame = (new GameItem (GameItemType.Equipment, info.equip_id, 1)).getIcon();
		frame.y = -35;
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}else if(type == TYPE_GOLD_KEY)	
	{	
		var frame = evtSpr.GetFrame(8, 0, 0);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}
	
	label.Update();
	label.Render();
	item.addChild(label);
	return item;
});

//Type: 0 reward bình thường, 1: daily
functionList.set ("receiveDailyRewards", function (listreward, type){
	var request = new Request(3);
	var content = new FBObjectOutput();
	content.putString("cmd", "rewards");
	var arr = new FBArrayOutput();
	trace("Wil receive reward:");
	if (listreward != null)
	{
		for (item in listreward) {
			if(item.rw_type != RewardItemInfo.TYPE_RESTORE_AP)
			{
				arr.putInt(item.itemId);
				trace("id: " + item.itemId);
			}
		}
	}
	content.putArray("lit", arr);
	content.putInt("ty", type);
	request.setContent(content);
	return request;
});

functionList.set ("createUIEvent2", function (){
