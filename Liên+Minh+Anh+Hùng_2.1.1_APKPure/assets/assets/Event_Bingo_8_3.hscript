var TYPE_AP = 0;
var TYPE_COIN = 1;
var TYPE_XP2 = 2;
var TYPE_FP = 3;
var TYPE_RUNE = 4;
var TYPE_RANDOM_CARD = 5;
var TYPE_ARMORSET = 6;
var TYPE_RANDOM_EQUIP = 7;
var TYPE_GOLD_KEY = 8;
var TYPE_EQUIP_ITEM = 9;
var TYPE_CARD = 10;

var EVENT_BINGO = 0;
var EVENT_MISSIONS = 1;

var BTN_NORMAL = 0;
var BTN_DISABLE = 1;
                                     //   	 In Time        Got		 	completed
var STATUS_EXPIRED 		= 0;		 //      no	(early)		no			n/a
var STATUS_CLAIMED 		= 1;		//		 n/a			yes			n/a
var STATUS_COMPLETED 	= 2;		//		 yes			no			yes
var STATUS_WAITGET		= 3;		//		 yes			n/a			no
var STATUS_NOTNOW	   	= 4;		//		 no	(late)		n/a			n/a

var currentDay = 1;

var functionList = new FunctionList ();

functionList.set ("getCurrentDateEvent", function ()
{
	var curTime = PixmaGame._instance.GetDateTime();
	var curDate = Date.fromTime(curTime);
	var d = curDate.getDate();
	var m = curDate.getMonth();
	var y = curDate.getFullYear();
	
	return new Date(y, m, d, 0, 0, 0);
});

functionList.set ("setDisableMouse", function (obj)
{
	trace("obj " + obj);
	trace("setDisableMouse is label " + Std.is (obj, Label) + " obj.numChildren " + obj.get_numChildren());
	var i = 0;
	while(i < obj.get_numChildren())
	{
		var child = obj.getChildAt(i);
		if(Std.is (obj, SimpleButton))
		{
			obj.set_mouseEnabled(true);
			obj.set_mouseChildren(true);
			trace("done");
		}
		else if(Std.is (child, DisplayObject))
			this.callFunction ("setDisableMouse", [child]);
		i++;
	}
});

functionList.set ("getConstGiftEvent", function (event)
{
	var curTime = PixmaGame._instance.GetDateTime();
	var curDate = Date.fromTime(curTime);
	var d = curDate.getDate();
	var m = curDate.getMonth();
	var y = curDate.getFullYear();
	var startDate = new Date(y, m, d, 0, 0, 0);
	var endDate = new Date(y, m, d+1, 0, 0, 0);

	trace("d " + d + " m " + m + " y " + y);
	
	var data = [];
	trace("getConstGiftEvent 11111111");
	
	if(event == EVENT_BINGO)
		data = [
			{
				id:8107,
				day:new Date(2015, 1, 12, 0, 0, 0),
				type:TYPE_RANDOM_CARD,
				type_card:2,
				num:1,
				status:STATUS_NOTNOW,
				quest:"Hoàn thành 5 nhiệm vụ"
			},
			{
				id:8108,
				day:new Date(2015, 1, 12, 0, 0, 0),
				type:TYPE_RANDOM_CARD,
				type_card:2,
				num:1,
				status:STATUS_NOTNOW,
				quest:"Hoàn thành 5 nhiệm vụ"
			}
		];
	else if(event == EVENT_MISSIONS)	
		data = [
			{
				id:8117,
				day:new Date(2015, 1, 12, 0, 0, 0),
				type:TYPE_FP,
				desc:"x1000",
				status:STATUS_WAITGET,
				quest:"10 Bông Hồng"
			},
			{
				id:8118,
				day:new Date(2015, 1, 12, 0, 0, 0),
				type:TYPE_ARMORSET,
				type_armor:1,
				desc:"20 Bộ",
				status:STATUS_NOTNOW,
				quest:"25 Bông Hồng"
			},
			{
				id:8119,
				day:new Date(2015, 1, 12, 0, 0, 0),
				type:TYPE_CARD,
				id_card:379,
				desc:"x7",
				status:STATUS_NOTNOW,
				quest:"50 Bông Hồng"
			},
			{
				id:8120,
				day:new Date(2015, 1, 12, 0, 0, 0),
				type:TYPE_AP,
				desc:"x1000",
				status:STATUS_NOTNOW,
				quest:"85 Bông Hồng"
			},
			{
				id:8121,
				day:new Date(2015, 1, 12, 0, 0, 0),
				type:TYPE_CARD,
				id_card:500,
				desc:"x1",
				status:STATUS_NOTNOW,
				quest:"130 Bông Hồng"
			},
			{
				id:8122,
				day:new Date(2015, 1, 12, 0, 0, 0),
				type:TYPE_RUNE,
				desc:"x20000",
				status:STATUS_NOTNOW,
				quest:"200 Bông Hồng"
			},
			{
				id:8123,
				day:new Date(2015, 1, 12, 0, 0, 0),
				type:TYPE_EQUIP_ITEM,
				equip_id:191,
				desc:"x1",
				status:STATUS_NOTNOW,
				quest:"250 Bông Hồng"
			},
			{
				id:8124,
				day:new Date(2015, 1, 12, 0, 0, 0),
				type:TYPE_GOLD_KEY,
				type_card:3,
				desc:"x15",
				status:STATUS_NOTNOW,
				quest:"300 Bông Hồng"
			},
			{
				id:8125,
				day:new Date(2015, 1, 12, 0, 0, 0),
				type:TYPE_RANDOM_CARD,
				type_card:3,
				desc:"x1",
				status:STATUS_NOTNOW,
				quest:"350 Bông Hồng"
			},
			{
				id:8126,
				day:new Date(2015, 1, 12, 0, 0, 0),
				type:TYPE_EQUIP_ITEM,
				equip_id:198,				
				desc:"x1",
				status:STATUS_NOTNOW,
				quest:"500 Bông Hồng"
			}
		];
	
	var itemStatusArr = RewardItemInfo.GetDinamicListRewards();
	var idRewardReceivedArr = RewardItemInfo.finish_recieve_rewards;
	trace("itemStatusArr " + itemStatusArr);
	trace("idRewardReceivedArr " + idRewardReceivedArr);
	for(info in data)
	{
		trace("id " + info.id);
		if(info.day != null)
		{
			trace("info.day.getTime() " + info.day.getTime());
			trace("startDate.getTime() " + startDate.getTime());
			trace("endDate.getTime() " + endDate.getTime());
			trace("info.day " + info.day);
			trace("startDate " + startDate);
			trace("endDate " + endDate);
			var deltaBefore = (startDate.getTime() - info.day.getTime());
			var deltaAfter = (info.day.getTime() - endDate.getTime());
			trace("deltaBefore " + deltaBefore);
			trace("deltaAfter " + deltaAfter);
			if(deltaBefore > 0)
				info.status = STATUS_EXPIRED;
			else if(deltaAfter >= 0)
				info.status = STATUS_NOTNOW;
			// else
				// info.status = STATUS_WAITGET;
		}
			
		for(item in itemStatusArr)
		{
			trace("item.itemId " + item.itemId);
			if(item.itemId == info.id)
			{
				if(item.isFinish)
				{
					trace("item id finised " + item.itemId);
					info.status = STATUS_COMPLETED;
					info.reward = item;
				}
				else{
					trace("item id not finish " + item.itemId);
					info.status = STATUS_WAITGET;
					info.reward = item;
				}
			}
		}
		
		for(id in idRewardReceivedArr)
		{
			if(id == info.id)
			{
				trace("claimed id " + id);
				info.status = STATUS_CLAIMED;
			}
		}
	}
	
	return data;
});

functionList.set ("getItemReward", function (type, value)
{
	trace("type " + type + " value " + value);
	var str = "x" + value;
	var evtSpr = Resource.getSprite ("GFX_EVENT_GENERAL_ITEM");
	var specialSpr = Resource.getSprite ("GFX_SPECIAL_ICON");
	var item = new Layer();
	if(type == RewardItemInfo.TYPE_RED_AP)
		item.addChild(evtSpr.GetFrame(3, 0, -15));
	else if(type == RewardItemInfo.TYPE_GOLD)	
		item.addChild(evtSpr.GetFrame(4, 0, -15));	
	else if(type == 26) // else if(type == TYPE_XP2)
	{	
		item.addChild(evtSpr.GetFrame(5, 0, -15));
		str = "x" + (value/(3600*24)) + " Ngày";
	}
	else if(type == RewardItemInfo.TYPE_FP)	
		item.addChild(evtSpr.GetFrame(6, 0, -15));
	else if(type == RewardItemInfo.TYPE_RUNE)	
		item.addChild(evtSpr.GetFrame(7, 0, -15));
	else if(type == RewardItemInfo.TYPE_CARD)	
	{
		if(value != null)
		{
			var iter = value.getInteratorSet();
			var arr = [];
			while (iter.hasNext()) {
				var obj = iter.next();
				var cardInfo = ParseObject.toCardInfo(obj);
				var card = new SmallIcon (cardInfo, 0, -35, {type:0, levelMode:0});
				card.card_id = cardInfo.GetId();
				card.Scale(0.8, 0.8);
				var i = 0;
				while(i < arr.length)
				{
					if(arr[i].card_id == cardInfo.GetId())
					{
						arr[i+1] = arr[i+1] + 1;
						break;
					}
					i+=2;
				}
				if(i >= arr.length)
				{
					arr.push(card);	
					arr.push(1);	
				}
			}
			
			var i = 0;
			var w = 100;
			var length = arr.length/2;
			var startX = -(w*(length-1))/2;
			while(i < arr.length)
			{
				arr[i].x = startX + Math.round(i/2) * w;				
				item.addChild(arr[i]);
				item.addChild(Label.create (arr[i+1], Fonts.TITLE_BLACK_20, arr[i].x, 5, Anchor.center_top));
				i+=2;				
			}
			str = "";	
		}
	}
	else if(type == RewardItemInfo.TYPE_SPECIALITEM)	
	{
		if(value != null)
		{
			var iter = value.getInteratorSet();
			while (iter.hasNext()) {
				var id = iter.next();
				var num = iter.next();
				var frame = (new GameItem (GameItemType.Special_Item, id, num)).getIcon();
				frame.y = -35;
				frame.Scale(0.8, 0.8);
				item.addChild(frame);
				str = "x" + num;		
			}
		}
	}
	else if(type == RewardItemInfo.TYPE_ARMOR)	
	{
		if(value != null)
		{
			var iter = value.getInteratorSet();
			var arr = [];

			while (iter.hasNext()) {
				var armorId = iter.next();
				var i = 0;
				while(i<arr.length)
				{
					trace("check arr[i] " + arr[i] + " armorId " + armorId);
					if(arr[i] == armorId)
					{
						arr[i+1] = arr[i+1] + 1;
						trace("arr[i] " + arr[i] + " arr[i+1] " + arr[i+1]);
						break;
					}
					i+=2;
				}
				if(i == arr.length)
				{
					arr.push(armorId);
					arr.push(1);
				}
				// ArmorSet.AddNumOfItem(armorId, 1);
			}

			trace("arr " + arr);
			var i = 0;
			var w = 100;
			var length = arr.length/2;
			var startX = -(w*(length-1))/2;
			Resource.loadSprite(SoftDefines.gfx_evolution_item);
			while(i<arr.length)
			{
				var icon_spr = Resource.getSprite(SoftDefines.gfx_evolution_item);
				var itemArmor  = ArmorSet.GetItem(arr[i]);
				var max_size = ArmorSet.GetNumOfConst();
				var _item_frame = icon_spr.GetFrame ( itemArmor.GetId() % max_size, startX + (i/2) * w, -35);
				
				_item_frame.Scale(0.8, 0.8);
				item.addChild(_item_frame);	
				item.addChild(Label.create (arr[i+1], Fonts.TITLE_BLACK_20, _item_frame.x, 5, Anchor.center_top));
				i+=2;
			}
		}
	
		value = null;
	}
	else if(type == RewardItemInfo.TYPE_EQUIP)	
	{
		if(value != null)
		{
			Resource.loadSprite (SoftDefines.gfx_equip_icon);
			var equiSpr = Resource.getSprite (SoftDefines.gfx_equip_icon);
			var iter = value.getInteratorSet();
			while (iter.hasNext())
			{
				var id = iter.next();
				var dura = iter.next();
				var dura_type = iter.next();
				var uid = iter.next();
				iter.next();
				// StockManager.addEquiment(id,dura,dura_type,uid,iter.next());
				var equipPro = EquipInfo.GetEquip(id);
				var equiFrame = equiSpr.GetFrame (equipPro.sprite_id, 0, -35);
				trace("id " + id + " equipPro.sprite_id " + equipPro.sprite_id);
				equiFrame.Scale(0.8, 0.8);
				item.addChild(equiFrame);
			}
		// item.addChild(specialSpr.GetFrame(41, 0, 0));
			str = "x" + 1;	
		}
	}
	if(value != null)	
		item.addChild(Label.create (str, Fonts.TITLE_BLACK_20, 0, 5, Anchor.center_top));
	return item;
});

//only addchild not add on layer
functionList.set ("getButtonGift", function (str, mode)
{
	var evtSpr = Resource.getSprite ("GFX_EVENT_8_3");
	// var upState 	 = Border.roundRect (0, 0, -57, -20, 115 , 40, 10, 1, 0xe2620c, 1, 0xe2620c);
	var upState 	 = evtSpr.GetFrame(3, 0, 0);
	upState.Render();
	// var hitTestState = Border.roundRect (0, 0, -57, -20, 115 , 40, 10, 1, 0xDAA520, 1, 0xDAA520);
	var hitTestState = evtSpr.GetFrame(4, 0, 0);
	hitTestState.Render();
	upState.addChild(label = Label.create(str, Fonts.TITLE_BLACK_20, 0, 0, Anchor.center_center));
	label.Update();
	label.Render();
	hitTestState.addChild(label = Label.create(str, Fonts.TITLE_BLACK_20, 0, 0, Anchor.center_center));
	label.Update();
	label.Render();
	var btn = null;
	if(mode == BTN_NORMAL)
		btn = new SimpleButton(upState, hitTestState, hitTestState, hitTestState);
	else if(mode == BTN_DISABLE){
		var grayState = Border.roundRect (0, 0, -70, -20, 140 , 40, 10, 1, 0xA9A9A9, 1, 0xA9A9A9);
		grayState.Render();
		grayState.addChild(label = Label.create(str, Fonts.TITLE_WHITE_20, 0, 0, Anchor.center_center));
		label.Update();
		label.Render();
		btn = new SimpleButton(grayState, grayState, grayState, grayState);
		btn.enabled = false;
	}
	
	return btn;
});

functionList.set ("SetStatusMission", function(mission, status)
{
	trace("SetStatusMission 11111");
	var evtSpr = Resource.getSprite ("GFX_EVENT_GENERAL_ITEM");
	var frame = mission.box.getChildByName("status");
	if(frame != null)
		mission.box.removeChild(frame);
	var giftBtn = mission.box.getChildByName("giftbtn");
	giftBtn.visible = false;
		
	if(status == STATUS_EXPIRED)
	{			
		frame = evtSpr.GetFrame(1, 0, 0);
		frame.name = "status";
		mission.box.addChild(frame);
	}
	else if(status == STATUS_CLAIMED)
	{			
		frame = evtSpr.GetFrame(2, 0, 0);
		frame.name = "status";
		mission.box.addChild(frame);
	}
	else if(status == STATUS_WAITGET || status == STATUS_COMPLETED)
	{			
		giftBtn.visible = true;
	}
	else if(status == STATUS_NOTNOW)
	{			
		giftBtn.visible = false;
	}
	return giftBtn;
});

functionList.set ("getCloseButton", function ()
{
	var closeBtn = new DisplayObject();
	var graphic = closeBtn.getGraphics();
	graphic.clear ();
	graphic.lineStyle (1.5, 0xFFFFFF, 1.0);
	graphic.beginFill (0x000000, 0.5);
	graphic.drawCircle (0, 0, 24);
	graphic.endFill ();
	
	graphic.lineStyle (3, 0xFFFFFF, 1.0);
	graphic.moveTo (-10, -10);
	graphic.lineTo (10, 10);
	graphic.moveTo (10, -10);
	graphic.lineTo (-10, 10);
	
	return closeBtn;
});

functionList.set ("callPopup", function (msg)
{
	var w = 550;
	var h = 300;
	var popup = new Layer();
	// popup.x = 320;
	popup.y = 480;
	var hide = new ColorRect(0x000000, 0.0, -320, -480, 640, 960);
	hide.x = 0;
	hide.y = 0;
	popup.addChild(hide);
	var bg = new ColorRect(0x000000, 0.7, -320, -200, 640, 400);
	bg.x = 0;
	bg.y = 0;
	popup.addChild(bg);
	popup.addChild(Border.roundRect (0, 0, -w/2, -h/2, w , h, 30, 0, 0x000000, 1, 0xFFFFFF));
	
	var closeBtn = this.callFunction ("getCloseButton", []);
	closeBtn.x = 240;
	closeBtn.y = -120;
	popup.addChild(closeBtn);
	popup.addChild(Label.create(msg, Fonts.TITLE_BLACK_20, 0, -50, Anchor.center_center));
	this.add(popup);
	
	popup.addEventListener (MouseEvent.CLICK, function(e){
		this.remove(popup);
	});
	
	return popup;
});

