		// {			
			// frame = evtSpr.GetFrame(2, 0, 0)
			// m.box.addChild(frame);
		// }
	// }
	return mission;
});

functionList.set ("getGiftItem", function (info)
{
	trace("getGiftItem info " + info);
	var type = info.type;
	var desc = info.desc;
	if (desc == null) desc = "";
	 	 
	var specialSpr = Resource.getSprite ("GFX_SPECIAL_ICON");
	var evtSpr = Resource.getSprite ("GFX_EVENT_GENERAL_ITEM");
	var item = new DisplayObject();
	var font15 = new TextFormat (Fonts.CHAT_FONT, 15, 0x000000);
	var label = Label.create (desc, font15, 0, 10, Anchor.center_top);
	
	if(type == TYPE_AP)
	{
		var frame = evtSpr.GetFrame(3, 0, -10);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}else if(type == TYPE_COIN)	
	{
		var frame = evtSpr.GetFrame(4, 0, -10);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}
	else if(type == TYPE_XP2)
	{	
		item.addChild(evtSpr.GetFrame(5, 0, 0));
		label.text += " Ngày";
	}else if(type == TYPE_FP)	
	{
		var frame = evtSpr.GetFrame(6, 0, -10);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}else if(type == TYPE_RUNE)	
	{
		var frame = evtSpr.GetFrame(7, 0, -10);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}else if(type == TYPE_RANDOM_CARD)
	{	
		var frame = specialSpr.GetFrame(30 + info.type_card, 0, -35);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}
	else if(type == TYPE_CARD)
	{	
		var card = new CardInfo(info.id_card, "123");
		var cardIcon = new SmallIcon (card, 0, -35, {type:0, levelMode:0, scale:0.8});
		item.addChild(cardIcon);
	}else if(type == TYPE_ARMORSET)	
	{	
		var frame = specialSpr.GetFrame(35 + info.type_armor, 0, -35);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}else if(type == TYPE_RANDOM_EQUIP)	
	{	
		var frame = specialSpr.GetFrame(40 + info.type_equip, 0, -35);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}else if(type == TYPE_EQUIP_ITEM)	
	{	
		var frame = (new GameItem (GameItemType.Equipment, info.equip_id, 1)).getIcon();		
		frame.y = -35;
		frame.Scale(0.8, 0.8);
		item.addChild(frame);		
	}else if(type == TYPE_GOLD_KEY)	
	{	
		// var frame = evtSpr.GetFrame(8, 0, 0);
		var frame = (new GameItem (GameItemType.Special_Item, 38, 1)).getIcon();
		frame.y = -35;
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}
	
	label.Update();
	label.Render();
	item.addChild(label);
	return item;
});

//Type: 0 reward bình thường, 1: daily
functionList.set ("receiveDailyRewards", function (listreward, type){
	var request = new Request(3);
	var content = new FBObjectOutput();
	content.putString("cmd", "rewards");
	var arr = new FBArrayOutput();
	trace("Wil receive reward:");
	if (listreward != null)
	{
		for (item in listreward) {
			if(item.rw_type != RewardItemInfo.TYPE_RESTORE_AP)
			{
				arr.putInt(item.itemId);
				trace("id: " + item.itemId);
			}
		}
	}
	content.putArray("lit", arr);
	content.putInt("ty", type);
	request.setContent(content);
	return request;
});

functionList.set ("createUIEvent2", function (){
	var evtSpr = Resource.getSprite ("GFX_EVENT_8_3");
	var ui = new Layer();		
	
	var kata_frame = evtSpr.GetFrame(1, 460 + 65, 130);
	// kata_frame.Scale(0.8, 0.8);
	ui.add(kata_frame);			
	//line black
	// ui.add(Border.roundRect (0, 0, 5, 380 + 135, 630 , 420, 10, 1, 0x0000000, 1, 0x022742));

	//title event 2
	// ui.add(Label.create ("Nhiệm Vụ Đón Xuân", Fonts.TITLE_WHITE_30, 10, 20, Anchor.left_top));
	
	ui.add(Label.create ("* Thu thập bông hồng 8/3\n" +
						 "* Diễn ra từ 3/3 - 22/3\n" +
						 "* Bông Hồng là nguyên liệu quý hiếm để nâng cấp kỹ năng với tỉ lệ 15%\n" +
						 "* Các hoạt động đều nhận được Bông Hồng\n" +
						 "* Ngoài sự kiện săn Bông Hồng, sẽ có sự kiện tích lũy Bông Hồng nhận quà và thẻ bài hiếm(Nhận 1 lần duy nhất)", Fonts.TITLE_WHITE_20, 10, 20, Anchor.left_top, 390));
	//button 7 days	
	
	ui.add(evtSpr.GetFrame(0, -2, 335 - 70));	
	ui.add(evtSpr.GetFrame(5, 210, 345));	
	
	var total = null;
	
	var sumRose = function(got, max)
	{
		ui.remove(total);		
		total = Label.create ("<p align=\"center\">Đã Thu Thập\n" + got + "/" + max + "</p>", new TextFormat (Fonts.CHAT_FONT, 20, 0x000000), 305, 345/* - 20*/, Anchor.center_center);
		ui.add(total);		
	};
	
	var btn = this.callFunction ("getButtonGift", ["Mua", BTN_NORMAL]);
	btn.x = 305;
	btn.y = 345 + 20;
	btn.addEventListener (MouseEvent.MOUSE_UP, function(e)
	{
		trace("goto charge");
		ShopUtilities.buy (ShopData.RESOURCE, 180); //item hoa hong
	});
	ui.addChild(btn);
	
	var data2 = this.callFunction ("getConstGiftEvent", [EVENT_MISSIONS]);
	trace("data2 " + data2);
	
	var curValue = -1;
	// sumRose(0, 500);
	
	ui.addEventListener (Event.ENTER_FRAME, function(e){
		var final = null;
		var i = data2.length - 1;
		while(i >= 0)
		{
			var data = data2[i];
			final = RewardItemInfo.GetConstItem(data.id);
			if(final != null)
				break;
			i--;
		}
		// trace("cur " + curValue + " real " + final.currentValue);
		if(final != null && curValue != final.currentValue)
		{
			sumRose(final.currentValue, final.count_down);
			curValue = final.currentValue;
		}
	});
	/*
	// if(data2[data2.length-1].reward != null)
	if(final != null)
		// sumRose(data2[data2.length-1].reward.currentValue, data2[data2.length-1].reward.count_down);
		sumRose(final.currentValue, final.count_down);
	*/
	
	var table = [5, 5];
	var w = 115;
	var h = 148;	
	var h2 = 30;
	var padding = 10;
	
	var j = 0;
	var count = 0;
	var missionArr = [];
	var findMission = function(box)
	{
		trace("findMission box " + box);
		for(m in missionArr)
			if(m.box == box)
				return m;
		trace("nothing");
		return null;
	}
	
	for(row in table)
	{
		var total = row;
		var startX = (640-total*w - (total-1)*padding)/2 + w/2;
		var i = 0;
		while(i < total)
		{
			var info = data2[count];
			trace("1111111111");
			var mission = this.callFunction ("getButtonMission", [info, w, h, h2]);
				
			var font15 = new TextFormat (Fonts.CHAT_FONT, 15, 0xFFFFFF);
			mission.box.addChild(Label.create(info.quest, font15, 0, 61 - 130 + 9, Anchor.center_center));
			// trace("mission.info.reward " + mission.info.reward);
			// var detail = "<p align=\"center\">" + info.quest + "</p>";
			// if(mission.info.reward != null)
			// {
				// trace("mission.info.reward.currentValue " + mission.info.reward.currentValue);
				// trace("mission.info.reward.count_down " + mission.info.reward.count_down);
				// trace("mission.info.reward.rq_value " + mission.info.reward.rq_value);
				// detail = "<p align=\"center\">" + info.quest + " (" + mission.info.reward.currentValue + "/" + mission.info.reward.count_down + ")</p>";
			// }
			// mission.box.addChild(Label.create(detail, font15, 0, 61 - 130, Anchor.center_top, 180));
			missionArr.push(mission);
			mission.box.x = startX + (w+padding)*i;
			mission.box.y = 525 + (h+60)*j;
			trace("mission.box.y");
			this.callFunction ("SetStatusMission", [mission, info.status]);
			trace("his.callFunction ");
			mission.box.addEventListener (MouseEvent.CLICK, function(e)
				{
					var mission = findMission(e.currentTarget);	
					trace("findMission mission " +mission);					
					if(mission != null)
					{
						var data2 = this.callFunction ("getConstGiftEvent", [EVENT_MISSIONS]);
						for(data in data2)
						{
							if(mission.info.id == data.id)
							{
								mission.info = data;
								break;
							}
						}
						if(mission.info.status == STATUS_COMPLETED)
						{
							// var type = mission.info.reward.type;
							// var itemId = mission.info.reward.itemId;
							// PixmaGame._instance.fbClient.send (RequestGennarator.receiveDailyReward (itemId, type));	
							var	objArr = [];
							PixmaGame._instance.fbClient.send (this.callFunction ("receiveDailyRewards", [[mission.info.reward], 0]));
							PixmaGame._instance.fbClient.addEventListener(FBEvent.RECEIVE_REWARD, function (params)
								{
									this.callFunction ("SetStatusMission", [mission, STATUS_CLAIMED]);				
									RewardItemInfo.finish_recieve_rewards.push(mission.info.reward.itemId);
									var obj = this.callFunction ("getItemReward", [params.get("type"), params.get("value")]);									
									objArr.push(obj);
								});
							// PixmaGame._instance.fbClient.addEventListener(FBEvent.RECEIVE_REWARD_ERROR, function (params)
								// {
									// var msg = params.get("msg");
									// if(msg != null)
										// this.callFunction ("callPopup", [msg]);
								// });
							PixmaGame._instance.fbClient.addEventListener(FBEvent.RECEIVE_MULTI_REWARD,function (params)
								{
									PixmaGame._instance.fbClient.removeEventListener (FBEvent.RECEIVE_REWARD);
									PixmaGame._instance.fbClient.removeEventListener (FBEvent.RECEIVE_MULTI_REWARD);
									var mes = params.get("mes");
									trace("mes " + mes);
									this.callFunction ("SetStatusMission", [mission, STATUS_CLAIMED]);
									
									var popup = this.callFunction ("callPopup", [mes]);
									var i = 0;
									var w = 100;
									var length = objArr.length;
									var startX = -(w*(length-1))/2;
									for(obj in objArr)
									{
										obj.x = startX + i * w;
										obj.y = 80 ;
										popup.addChild(obj);
										i++;
									}
								});
						}else if(mission.info.status == STATUS_WAITGET)
							this.callFunction ("callPopup", ["Bạn chưa hoàn thành nhiệm vụ này!"]);				
					}		
				});
				
			ui.add(mission.box);
			trace(i+ " x " + mission.box.x + " y " + mission.box.y);
			
			i++;
			count++;
		}
		j++;
	}
	return ui;
});

functionList.set ("init", function ()
{
	Resource.loadSprite ("GFX_EVENT_8_3");
	Resource.loadSprite ("GFX_EVENT_GENERAL_ITEM");

	var rewardHolder = new Layer ();
	// rewardHolder.x = -320;
	// rewardHolder.y = -95;
	// this.add(rewardHolder);
	
	// rewardHolder.add(new ColorRect (0xFF0000, 0.5, 0, 0, 640, 960));
	
	// rewardHolder.add(Border.roundRect (0, 0, 0, 0, 640 , 960, 10, 1, 0xFFFFFF, 1, 0xFFFFFF));
	
	//bg event 1
	// var bg1 = new ColorRect (0xae1703, 1.0, 0, 0, 640, 960 + 210);
	// bg1.y = 0;
	// rewardHolder.add(bg1);
	
	//bg event 2
	// rewardHolder.add(new ColorRect (0x022742, 1.0, 0, 0, 640, 960));	
	rewardHolder.add(new ColorRect (0x035d63, 1.0, 0, 0, 640, 960));	
	
	// var line = new ColorRect (0xFFFFFF, 1.0, 0, 0, 640, 1);
	// line.y = 846;
	// rewardHolder.add(line);
	
	//header
	rewardHolder.add(new ColorRect (0x14a5da, 1.0, 0, 0, 640, 70));	
	var label = Label.create ("Sự Kiện Ngày Quốc Tế Phụ Nữ", Fonts.DETAIL_WHITE_30, 320, 10, Anchor.center_top);
	label.Update();
	label.Render();
	rewardHolder.add(label);
	
	trace("init 2222222222 ");
	var ui2 = this.callFunction ("createUIEvent2", []);
	ui2.y = 70;
	rewardHolder.add(ui2);
	trace("init 33333333 ");

	var scrollView = new PageScrollable (rewardHolder, 640, 960, PageScrollable.Ver);
	scrollView.x = -320;
	scrollView.y = -95;
	scrollView.removeEventListener (MouseEvent.MOUSE_OUT, scrollView.onRelease);
	scrollView.addEventListener (MouseEvent.MOUSE_OUT, function(e)
	{
		if(e.relatedObject == null)
		{
			if (scrollView.move) scrollView.waitRelease = true;
			
			scrollView.canMove = false;
			scrollView.move = false;
			scrollView.horizontal = false;
			scrollView.vertical = false;
		}
	});
	this.add(scrollView);
	
	// rewardHolder.set_mouseEnabled(false);
	// rewardHolder.set_mouseChildren(false);
		
	// this.callFunction ("setDisableMouse", [rewardHolder]);
	
	// this.close_btn = new Button (SoftDefines.gfx_main_ui, DF_UI.anim_tab_close_normal, DF_UI.anim_tab_close_touch);
	var closeBtn = this.callFunction ("getCloseButton", []);
	
	closeBtn.x = 600 - 320 + 5;
	closeBtn.y = 35 - 95;
	closeBtn.addEventListener (MouseEvent.CLICK, this.onBackUp);
	this.add (closeBtn);
});

return functionList;