var OnFinishHideEffect = function (arr) 
{
	for(obj in arr)
		sCurLayer.remove(obj);
}

var FocusCard = function (obj) 
{
	var focusBg = Resource.getSprite ("GFX_EFFECT_COVER", true).GetFrame (0);
	focusBg.x = - GraphicsConfig.VIEW_WIDTH / 2;
	focusBg.y = - GraphicsConfig.VIEW_HEIGHT / 2;
	focusBg.scaleX = GraphicsConfig.VIEW_WIDTH / focusBg.data.bound.width;
	focusBg.scaleY = GraphicsConfig.VIEW_HEIGHT / focusBg.data.bound.height;
	focusBg.alpha = 0.0;
	
	sCurLayer.add (focusBg);
	
	var showFocus = new OpacityEffect(focusBg, 0.8, 200, null);
	showFocus.Init();	
	sCurState.AddScript(showFocus);
	return focusBg;
}
var focusBg = FocusCard(attacker);
attacker.isLocked = true;	
attacker.GetDisplayCard().moveToTop();

var shootanim = Resource.getSprite(SoftDefines.gfx_sona_util_action).GetAnim (1, Std_int(attacker.xOri), Std_int(attacker.yOri), false, renderMode);
if(attacker.GetFormation().IsPlayer() == false)
	shootanim.SetRotate(180);
sCurLayer.add(shootanim);
var shooteffect = new SimulateAnimEffect(attacker.GetDisplayCard(), shootanim, 1000);
shooteffect.Init();
shooteffect.SetEffectListener(function (arr) 
							{
								sCurLayer.remove(shootanim);
							});
sCurState.AddScript(shooteffect);

// var centerX = 0;
// var centerY = attacker.GetFormation().IsPlayer() ? (-240) : (250);
var centerX = defender[0].GetDisplayCard().x;
var centerY = defender[0].GetDisplayCard().y;

var arrow = Resource.getSprite(spriteId).GetAnim(travAnim,Std_int(attacker.xOri), Std_int(attacker.yOri), true, renderMode);
arrow.SetRotate(AngleBetweenPoints(new gPoint(attacker.xOri, attacker.yOri), new gPoint(centerX, centerY)) + 90);		
arrow.SetOpacity(0);
arrow.Scale(2.0, 2.0);
sCurLayer.add(arrow);	

var showeff = new OpacityEffect(arrow, 0, 200, shooteffect);
showeff.Init();
sCurState.AddScript(showeff);
showeff.AddEffectListener(function OnFinishHideEffect(arr)
{	
	arrow.SetOpacity(1.0);
});


var meff = new MovingEffect(arrow, centerX - attacker.xOri, centerY - attacker.yOri, 500, shooteffect);
meff.SetEffectListener(OnFinishHideEffect);
meff.Init();
sCurState.AddScript(meff);

cbUpdate = function(obj){
	if(shooteffect.TimeRemaining() < 300)
	{
		showeff.SetDependEffect(null);
		meff.SetDependEffect(null);
		shooteffect.RemoveCallbackPerUpdate(cbUpdate);
	}
};
shooteffect.AddCallbackPerUpdate(cbUpdate);

meff.AddEffectListener(function (arr)
{
	sCurLayer.remove(focusBg);
	attacker.isLocked = false;
	
	var hAnim = Resource.getSprite(spriteId).GetAnim (hitAnim, centerX, centerY, false, renderMode);
	sCurLayer.add (hAnim);
	hAnim.Scale(1.5, 1.5);

	var aeff = new AnimEffect(false, hAnim, 666, null);
	aeff.SetEffectListener(OnFinishHideEffect);
	aeff.Init();
	sCurState.AddScript(aeff);
	
	var setcb = true;
	if(setcb == true)
	{
		var nextstep = true;
		aeff.AddCallbackPerUpdate(function (arr){
						if(aeff.TimeRemaining() < 200 && nextstep)
						{
							sCurState.nextStep = true;
							nextstep = false;
						}
					});
		setcb = false;
	}
});



var endEffect = [];
var hitAnimArray = [];
for(card in defender)
{			
	var hAnim = Resource.getSprite(spriteId).GetAnim (hitAnim, Std_int(card.xOri), Std_int(card.yOri), false, renderMode);
	if(card.isBoss)
		hAnim.Scale(GameStateCardBattle.SCALE_RATIO_NORMAL_BOSS, GameStateCardBattle.SCALE_RATIO_NORMAL_BOSS);
	meff.AddEffectListener(function OnFinishHideEffect(arr)
					{
						Sound.GetSound(sound).Play();
					});
	
	var anim = new SimulateAnimEffect(card.GetDisplayCard(), hAnim, 666, meff);			
	anim.Init();
	sCurState.AddScript(anim);
			
	endEffect.push(anim);
	// endEffect.push(meff);
}
endEffect;