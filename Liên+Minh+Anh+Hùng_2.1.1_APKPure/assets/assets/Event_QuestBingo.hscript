});

functionList.set ("getGiftItem", function (info)
{
	var type = info.type;
	var num = info.num;
	 	 
	var specialSpr = Resource.getSprite ("GFX_SPECIAL_ICON");
	var evtSpr = Resource.getSprite ("GFX_EVENT_BINGO");
	var item = new DisplayObject();
	var font15 = new TextFormat (Fonts.TITLE_FONT, 15, 0x000000);
	var label = Label.create ("x" + num, font15, 0, 5, Anchor.center_top);
	
	if(type == TYPE_AP)
		item.addChild(evtSpr.GetFrame(3, 0, 0));
	else if(type == TYPE_COIN)	
		item.addChild(evtSpr.GetFrame(4, 0, 0));
	else if(type == TYPE_XP2)
	{	
		item.addChild(evtSpr.GetFrame(5, 0, 0));
		label.text += " Ngày";
	}else if(type == TYPE_FP)	
		item.addChild(evtSpr.GetFrame(6, 0, 0));
	else if(type == TYPE_RUNE)	
		item.addChild(evtSpr.GetFrame(7, 0, 0));
	else if(type == TYPE_RANDOM_CARD)
	{	
		var frame = specialSpr.GetFrame(30 + info.type_card, 0, -35);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}else if(type == TYPE_ARMORSET)	
	{	
		var frame = specialSpr.GetFrame(35 + info.type_armor, 0, -35);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}else if(type == TYPE_RANDOM_EQUIP)	
	{	
		var frame = specialSpr.GetFrame(40 + info.type_equip, 0, -35);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}else if(type == TYPE_EQUIP_ITEM)	
	{	
		var frame = (new GameItem (GameItemType.Equipment, info.equip_id, 1)).getIcon();
		frame.y = -35;
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}else if(type == TYPE_GOLD_KEY)	
	{	
		var frame = evtSpr.GetFrame(8, 0, 0);
		frame.Scale(0.8, 0.8);
		item.addChild(frame);
	}
	
	label.Update();
	label.Render();
	item.addChild(label);
	return item;
});

//Type: 0 reward bình thường, 1: daily
functionList.set ("receiveDailyRewards", function (listreward, type){
	var request = new Request(3);
	var content = new FBObjectOutput();
	content.putString("cmd", "rewards");
	var arr = new FBArrayOutput();
	trace("Wil receive reward:");
	if (listreward != null)
	{
		for (item in listreward) {
			if(item.rw_type != RewardItemInfo.TYPE_RESTORE_AP)
			{
				arr.putInt(item.itemId);
				trace("id: " + item.itemId);
			}
		}
	}
	content.putArray("lit", arr);
	content.putInt("ty", type);
	request.setContent(content);
	return request;
});

functionList.set ("createUIEvent1", function (){
	var evtSpr = Resource.getSprite ("GFX_EVENT_BINGO");
	var ui = new Layer();
		
	//panel reward new comer
	ui.add(Border.roundRect (0, 0, 450 - 200/2, 130, 200, 165, 10, 1, 0x0000000, 1, 0xf8b79b));
	ui.add(Border.roundRect (0, 0, 450 - 200/2, 130 + 165 - 80, 200 , 80, 10, 1, 0x0000000, 1, 0xFFFFFF));
	
	// ahri
	ui.add(evtSpr.GetFrame(9, 150, 120));	
	
	//title event 1
	ui.add(Label.create ("Phần Thưởng Đặc Biệt", Fonts.TITLE_WHITE_30, 450, -5, Anchor.center_center));
	ui.add(Label.create ("Hoàn thành 5 nhiệm vụ trên", Fonts.TITLE_WHITE_20, 450, 30, Anchor.center_center));
	
	var btnNewComer = this.callFunction ("getButtonGift", ["Nhận Quà", BTN_NORMAL]);
	btnNewComer.x = 460;
	btnNewComer.y = 80;
	ui.addChild(btnNewComer);
	
	trace("before 111111111");
	var data1 = this.callFunction ("getConstGiftEvent", [EVENT_BINGO]);
	
	var total = data1.length; 
	var padding = 130;
	var startX = 450;
	// var startX = (640 - 600)/2 + (600-(total-1)*padding)/2;
	var i = 0;
	for(info in data1)
	{
		var obj = this.callFunction ("getGiftItem", [info]);
		obj.x = startX + i*padding;
		obj.y = 230;
		ui.addChild(obj);
		i++;
	}
	
	var fontblack15 = new TextFormat (Fonts.TITLE_FONT, 15, 0x000000);
	ui.add(Label.create ("Ngẫu nhiên thẻ bài tím", fontblack15, startX, 265, Anchor.center_top));
	
	trace("data1 " + data1);
	var itemStatusArr = RewardItemInfo.GetDinamicListRewards();
	var filterRewardArr = itemStatusArr.filter(function(reward){
		for(info in data1)
			if(reward.itemId == info.id/* && info.status == STATUS_COMPLETED*/)
				return true;
		return false;
	});
	trace("filterRewardArr " + filterRewardArr);
	
	if(filterRewardArr.length == 0)
	{
		ui.removeChild(btnNewComer);
		// var btn = this.callFunction ("getButtonGift", ["Đã Nhận", BTN_DISABLE]);
		// btn.x = btnNewComer.x;
		// btn.y = btnNewComer.y;
		// ui.addChild(btn);
		ui.addChild(Resource.getSprite ("GFX_EVENT_BINGO").GetFrame(2, startX, 230));
	}else
	{
		btnNewComer.addEventListener (MouseEvent.CLICK, function(e)
		{
			trace("filterRewardArr[0].status " + filterRewardArr[0].isFinish);
			if(filterRewardArr[0].isFinish == false)
			{
				this.callFunction ("callPopup", ["Bạn chưa hoàn thành nhiệm vụ này!"]);		
			}else{
				var	objArr = [];
				trace("get reward newcomer");
				PixmaGame._instance.fbClient.send (this.callFunction ("receiveDailyRewards", [filterRewardArr, 0]));
				PixmaGame._instance.fbClient.addEventListener(FBEvent.RECEIVE_REWARD, function (params)
					{					
						var obj = this.callFunction ("getItemReward", [params.get("type"), params.get("value")]);		objArr.push(obj);
					});
				PixmaGame._instance.fbClient.addEventListener(FBEvent.RECEIVE_MULTI_REWARD,function (params)
					{
						PixmaGame._instance.fbClient.removeEventListener (FBEvent.RECEIVE_REWARD);
						PixmaGame._instance.fbClient.removeEventListener (FBEvent.RECEIVE_MULTI_REWARD);
						for(reward in filterRewardArr)
							RewardItemInfo.finish_recieve_rewards.push(reward.itemId);
						var mes = params.get("mes");
						trace("mes " + mes);
						ui.removeChild(btnNewComer);
						var btn = this.callFunction ("getButtonGift", ["Đã Nhận", BTN_DISABLE]);
						btn.x = btnNewComer.x;
						btn.y = btnNewComer.y;
						ui.addChild(btn);
						
						var popup = this.callFunction ("callPopup", [mes]);
						var i = 0;
						var w = 100;
						var length = objArr.length;
						var startX = -(w*(length-1))/2;
						for(obj in objArr)
						{
							obj.x = startX + i * w;
							obj.y = 80 ;
							popup.addChild(obj);
							i++;
						}
					});
			}
		});
	}	
	return ui;
});

functionList.set ("createUIEvent2", function (){
	var evtSpr = Resource.getSprite ("GFX_EVENT_BINGO");
	var ui = new Layer();		
	
	var gnar_frame = evtSpr.GetFrame(0, 460, 135);
	gnar_frame.Scale(0.8, 0.8);
	ui.add(gnar_frame);		
	//line black
	// ui.add(Border.roundRect (0, 0, 5, 380 + 135, 630 , 420, 10, 1, 0x0000000, 1, 0x022742));

	//title event 2
	ui.add(Label.create ("Nhiệm Vụ Đón Xuân", Fonts.TITLE_WHITE_30, 10, 20, Anchor.left_top));
	
	ui.add(Label.create ("    * Diễn ra từ 30/1 - 6/2", Fonts.TITLE_WHITE_20, 10, 80, Anchor.left_center));
	ui.add(Label.create ("    * Hoàn thành từng nhiệm vụ để nhận quà", Fonts.TITLE_WHITE_20, 10, 115, Anchor.left_center, 320));
	ui.add(Label.create ("    * Chỉ nhận 1 lần duy nhất", Fonts.TITLE_WHITE_20, 10, 150, Anchor.left_center, 320));
	//button 7 days	
	
	var data2 = this.callFunction ("getConstGiftEvent", [EVENT_MISSIONS]);
	trace("data2 " + data2);
	
	var table = [3, 2];
	var w = 200;
	var h = 200;	
	var h2 = 35;
	var padding = 12;
	
	var j = 0;
	var count = 0;
	var missionArr = [];
	var findMission = function(box)
	{
		trace("findMission box " + box);
		for(m in missionArr)
			if(m.box == box)
				return m;
		trace("nothing");
		return null;
	}
	
	for(row in table)
	{
		var total = row;
		var startX = (640-total*w - (total-1)*padding)/2 + w/2;
		var i = 0;
		while(i < total)
		{
			var info = data2[count];
			trace("1111111111");
			var mission = this.callFunction ("getButtonMission", [info, w, h, h2]);
				
			mission.box.addChild(Label.create("Nhiệm vụ " + (count + 1), Fonts.TITLE_BLACK_20, 0, -85, Anchor.center_center));
			var font15 = new TextFormat (Fonts.TITLE_FONT, 15, 0x000000);
			mission.box.addChild(Label.create("<p align=\"center\">" + info.quest + "</p>", font15, 0, 63, Anchor.center_top, 180));
			missionArr.push(mission);
			mission.box.x = startX + (w+padding)*i;
			mission.box.y = 255 + 80 + (h+60)*j;
			trace("mission.box.y");
			this.callFunction ("SetStatusMission", [mission, info.status]);
			trace("his.callFunction ");
			mission.box.addEventListener (MouseEvent.CLICK, function(e)
				{
					var mission = findMission(e.currentTarget);	
					trace("findMission mission " +mission);					
					if(mission != null)
					{
						if(mission.info.status == STATUS_COMPLETED)
						{
							// var type = mission.info.reward.type;
							// var itemId = mission.info.reward.itemId;
							// PixmaGame._instance.fbClient.send (RequestGennarator.receiveDailyReward (itemId, type));	
							var	objArr = [];
							PixmaGame._instance.fbClient.send (this.callFunction ("receiveDailyRewards", [[mission.info.reward], 0]));
							PixmaGame._instance.fbClient.addEventListener(FBEvent.RECEIVE_REWARD, function (params)
								{
									this.callFunction ("SetStatusMission", [mission, STATUS_CLAIMED]);				
									RewardItemInfo.finish_recieve_rewards.push(mission.info.reward.itemId);
									var obj = this.callFunction ("getItemReward", [params.get("type"), params.get("value")]);									
									objArr.push(obj);
								});
							// PixmaGame._instance.fbClient.addEventListener(FBEvent.RECEIVE_REWARD_ERROR, function (params)
								// {
									// var msg = params.get("msg");
									// if(msg != null)
										// this.callFunction ("callPopup", [msg]);
								// });
							PixmaGame._instance.fbClient.addEventListener(FBEvent.RECEIVE_MULTI_REWARD,function (params)
								{
									PixmaGame._instance.fbClient.removeEventListener (FBEvent.RECEIVE_REWARD);
									PixmaGame._instance.fbClient.removeEventListener (FBEvent.RECEIVE_MULTI_REWARD);
									var mes = params.get("mes");
									trace("mes " + mes);
									this.callFunction ("SetStatusMission", [mission, STATUS_CLAIMED]);
									
									var popup = this.callFunction ("callPopup", [mes]);
									var i = 0;
									var w = 100;
									var length = objArr.length;
									var startX = -(w*(length-1))/2;
									for(obj in objArr)
									{
										obj.x = startX + i * w;
										obj.y = 80 ;
										popup.addChild(obj);
										i++;
									}
								});
						}else if(mission.info.status == STATUS_WAITGET)
							this.callFunction ("callPopup", ["Bạn chưa hoàn thành nhiệm vụ này!"]);				
					}		
				});
				
			ui.add(mission.box);
			trace(i+ " x " + mission.box.x + " y " + mission.box.y);
			
			i++;
			count++;
		}
		j++;
	}
	return ui;
});

functionList.set ("init", function ()
{
	Resource.loadSprite ("GFX_EVENT_BINGO");
	var evtSpr = Resource.getSprite ("GFX_EVENT_BINGO");

	var rewardHolder = new Layer ();
	// rewardHolder.x = -320;
	// rewardHolder.y = -95;
	// this.add(rewardHolder);
	
	// rewardHolder.add(new ColorRect (0xFF0000, 0.5, 0, 0, 640, 960));
	
	// rewardHolder.add(Border.roundRect (0, 0, 0, 0, 640 , 960, 10, 1, 0xFFFFFF, 1, 0xFFFFFF));
	
	
	//bg event 2
	// rewardHolder.add(new ColorRect (0x022742, 1.0, 0, 0, 640, 960));	
	rewardHolder.add(new ColorRect (0x132243, 1.0, 0, 0, 640, 880));	
	//bg event 1
	var bg1 = new ColorRect (0x374e6d, 1.0, 0, 0, 640, 380);
	bg1.y = 825;
	rewardHolder.add(bg1);
	
	var line = new ColorRect (0xFFFFFF, 1.0, 0, 0, 640, 3);
	line.y = 825;
	rewardHolder.add(line);
	
	//header
	rewardHolder.add(new ColorRect (0x63C0E2, 1.0, 0, 0, 640, 70));	
	var label = Label.create ("Sự Kiện Đón Xuân", Fonts.DETAIL_WHITE_30, 320, 10, Anchor.center_top);
	label.Update();
	label.Render();
	rewardHolder.add(label);

	trace("init 111111111 ");
	var ui1 = this.callFunction ("createUIEvent1", []);
	ui1.y = 865;
	rewardHolder.add(ui1);
		
	trace("init 2222222222 ");
	var ui2 = this.callFunction ("createUIEvent2", []);
	ui2.y = 70;
	rewardHolder.add(ui2);
	trace("init 33333333 ");
		
	var scrollView = new PageScrollable (rewardHolder, 640, 960, PageScrollable.Ver);
	scrollView.x = -320;
	scrollView.y = -95;
	scrollView.removeEventListener (MouseEvent.MOUSE_OUT, scrollView.onRelease);
	scrollView.addEventListener (MouseEvent.MOUSE_OUT, function(e)
	{
		if(e.relatedObject == null)
		{
			if (scrollView.move) scrollView.waitRelease = true;
			
			scrollView.canMove = false;
			scrollView.move = false;
			scrollView.horizontal = false;
			scrollView.vertical = false;
		}
	});
	this.add(scrollView);
	
	// rewardHolder.set_mouseEnabled(false);
	// rewardHolder.set_mouseChildren(false);
		
	// this.callFunction ("setDisableMouse", [rewardHolder]);
	
	// this.close_btn = new Button (SoftDefines.gfx_main_ui, DF_UI.anim_tab_close_normal, DF_UI.anim_tab_close_touch);
	var closeBtn = this.callFunction ("getCloseButton", []);
	
	closeBtn.x = 600;
	closeBtn.y = 35;
	closeBtn.addEventListener (MouseEvent.CLICK, this.onBackUp);
	rewardHolder.add (closeBtn);
});

return functionList;