var OnFinishHideEffect = function (arr) 
{
	for(obj in arr)
		sCurLayer.remove(obj);
}

var FocusCard = function (obj) 
{
	var focusBg = Resource.getSprite ("GFX_EFFECT_COVER", true).GetFrame (0);
	focusBg.x = - GraphicsConfig.VIEW_WIDTH / 2;
	focusBg.y = - GraphicsConfig.VIEW_HEIGHT / 2;
	focusBg.scaleX = GraphicsConfig.VIEW_WIDTH / focusBg.data.bound.width;
	focusBg.scaleY = GraphicsConfig.VIEW_HEIGHT / focusBg.data.bound.height;
	focusBg.alpha = 0.0;
	
	sCurLayer.add (focusBg);
	
	var showFocus = new OpacityEffect(focusBg, 0.8, 200, null);
	showFocus.Init();	
	sCurState.AddScript(showFocus);
	return focusBg;
}

var focusBg = FocusCard(attacker);
attacker.isLocked = true;	
attacker.GetDisplayCard().moveToTop();

var shootanim = Resource.getSprite(spriteId).GetAnim (castAnim, Std_int(attacker.xOri), Std_int(attacker.yOri), false, renderMode);
sCurLayer.add(shootanim);
var shooteffect = new SimulateAnimEffect(attacker.GetDisplayCard(), shootanim, 2000);
shooteffect.Init();
shooteffect.SetEffectListener(function (arr)
							{
								sCurLayer.remove(shootanim);
							});
sCurState.AddScript(shooteffect);

var endEffect = [];
var hitAnimArray = [];
var setcb = true;
var timePerArrow = 200;
var maxArrow= 3;
var i = 0;
var initPosArr = [0, -50, -70, 50, 70, 50];

for(card in defender)
{	
	var lastMeff = null;
	// while(i < maxArrow)
	{
		var arrow = Resource.getSprite(spriteId).GetAnim(travAnim,Std_int(attacker.xOri) + initPosArr[i*2], Std_int(attacker.yOri) + initPosArr[i*2 + 1], true, renderMode);	
		arrow.SetRotate(AngleBetweenCards(attacker, card) + 90);
		arrow.SetOpacity(0);
		// arrow.useBlendMode = true;
		sCurLayer.add(arrow);	
		
		var showeff = new OpacityEffect(arrow, 1, 50, null);
		showeff.Init();
		
		var meff = new MovingEffect(arrow, card.xOri - arrow.x,card.yOri - arrow.y, 500, null);
		meff.SetEffectListener(OnFinishHideEffect);
		meff.Init();
		var cbUpdate = null;
		cbUpdate = function(obj){
			if(shooteffect.TimeRemaining() < timePerArrow)
			{
				sCurState.AddScript(showeff);
				sCurState.AddScript(meff);
				shooteffect.RemoveCallbackPerUpdate(cbUpdate);
				sCurLayer.remove(focusBg);
				attacker.isLocked = false;
			}
		};
		
		shooteffect.AddCallbackPerUpdate(cbUpdate);
		
		lastMeff = meff;
		i=(i+1)%maxArrow;
	}
	
	var hitAnim = Resource.getSprite(spriteId).GetAnim (hitAnim, Std_int(card.xOri), Std_int(card.yOri), false, renderMode);
	if (GameStateCardBattle.rotateBattle)
		hitAnim.rotation = -90;
	if(card.isBoss)
		hitAnim.Scale(GameStateCardBattle.SCALE_RATIO_NORMAL_BOSS, GameStateCardBattle.SCALE_RATIO_NORMAL_BOSS);
	
	var anim = new SimulateAnimEffect(card.GetDisplayCard(), hitAnim, 666, lastMeff);			
	anim.AddEffectListener(function OnFinishHideEffect(arr)
					{
						sCurLayer.remove(hitAnim);
					});
	anim.Init();
	
	lastMeff.AddEffectListener(function OnFinishHideEffect(arr)
					{
						sCurLayer.add(hitAnim);
						Sound.GetSound(sound).Play();
					});
	sCurState.AddScript(anim);
	if(setcb == true)
	{
		var nextstep = true;
		anim.AddCallbackPerUpdate(function (arr){
						if(anim.TimeRemaining() < waitTime && nextstep)
						{
							sCurState.nextStep = true;
							nextstep = false;
						}
					});
		setcb = false;
	}
	
	endEffect.push(anim);	
}
endEffect