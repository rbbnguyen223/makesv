//end include

var functionList = new FunctionList ();

functionList.set ("init", function ()
{
	trace ("callGiftCode init");
	var inbox_infos = InboxInfo.GetListReward();
	if(inbox_infos.length > 0)
	{
		var giftcode = HomeState._instance.callGiftCode (inbox_infos[0]);
		giftcode.addEventListener (
						"ON_SEND",
						function (e)
						{			
							trace ("ON_SEND init 1");
							PixmaGame._instance.fbClient.addEventListener("GIFT_CODE", function (params)
							{
								if (params.get ("error") != null)
								{
									PixmaGame.notification.showPopup (TextWrapper.getString("TEXT_ERROR"), params.get("message"), 1);
									return;
								}
								
								var rewards = params.get ("rewards");
								var popup = PixmaGame.notification.showRewards (TextWrapper.getString("TEXT_CONFIRM"), TextWrapper.getString("TEXT_RECEIVE_REWARD_SUCCESS"), rewards, 1);
							});
							PixmaGame._instance.fbClient.send (RequestGennarator.giftCode (giftcode.getContent () , giftcode.reward_info.inbox_id));
						}
		);
	}
	
});



return functionList;